---
interface Props {
  title: string;
  description?: string;
  lang?: 'de' | 'en';
  alwaysShowNav?: boolean;
  robots?: string;
  ogType?: string;
  autoLangRedirect?: boolean;
  /**
   * Share-card override, relative to the site base (e.g. 'blog/my-post-card.png').
   * Must be a 1200x630 PNG — those dimensions are declared in the meta tags.
   */
  ogImage?: string;
  /** Extra JSON-LD nodes for this page, appended to the shared @graph (see src/utils/structured-data.ts). */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = "Klartext AI - We don't build chatbots. We turn AI into ROI.",
  lang = 'en',
  alwaysShowNav = false,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  autoLangRedirect = false,
  ogImage,
  structuredData = []
} = Astro.props;

import '@fontsource/inter/latin.css';
import '../styles/global.css';
import '../styles/contrast.css';
// The hero headline renders at weight 350, which CSS font matching resolves to the
// 300 face; 400 carries nav and body copy. Without a preload both are only discovered
// after the stylesheet parses, which delays the largest contentful paint.
import interLatin300 from '@fontsource/inter/files/inter-latin-300-normal.woff2?url';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Navigation from '../components/Navigation.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLanguagePaths } from '../utils/i18n';
import { CONTRAST_SCHEMES, CONTRAST_STORAGE_KEY, contrastSchemeCss } from '../utils/contrast-schemes';
import { DOCLARITY_ID, EXTRACT_ID, ORGANIZATION_ID, founderSchema } from '../utils/structured-data';
const BASE = import.meta.env.BASE_URL;
const SITE = Astro.site?.toString() ?? 'https://klartext-ai.github.io';

// Tracking configuration (only active in production)
const isProd = import.meta.env.PROD;
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;

// Warn if GA4_ID is missing in production build
if (isProd && !GA4_ID) {
  console.warn('⚠️  WARNING: PUBLIC_GA4_ID is not set. Google Analytics will not be loaded.');
}
const url = Astro.url;
// Determine canonical and language alternates
const canonicalHref = url?.href ?? SITE;
const languagePaths = getLanguagePaths(url?.pathname ?? '/', BASE);
const deHref = new URL(languagePaths.de, SITE).toString();
const enHref = new URL(languagePaths.en, SITE).toString();
const locale = lang === 'en' ? 'en_US' : 'de_DE';

// Social share card (1200x630). Generated from docs/brand/klartext-og.html via
// docs/brand/generate-og.sh; see that file before editing the artwork.
// One card serves both languages — its copy is English brand copy throughout
// (the positioning line is English on the German site too), so the alt text
// transcribing it is English regardless of `lang`.
const OG_IMAGE_ALT = 'Klartext AI — We build what’s next. Cutting-edge AI solutions for companies. New AI ventures for the world. Industry · Research · Ventures.';
const ogImageUrl = new URL(`${BASE}${ogImage ?? 'og-image.png'}`, SITE).toString();

// Page colour per contrast scheme, for the pre-paint script below. Only known schemes are
// applied, whatever storage holds.
const contrastGrounds = Object.fromEntries(CONTRAST_SCHEMES.filter((s) => s.id !== 'default').map((s) => [s.id, s.bg]));
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  {autoLangRedirect && (
    <script is:inline set:html={`(function(){try{
      var KEY='kt-lang-choice';
      var stored=null;try{stored=localStorage.getItem(KEY);}catch(e){}
      if(stored){if(stored==='de'){window.location.replace('${BASE}de/');}return;}
      var ua=navigator.userAgent||'';
      if(/bot|crawl|spider|slurp|bingpreview|googlebot|facebookexternalhit|embedly|quora|pinterest|whatsapp|telegram|applebot|duckduckbot|baiduspider|yandex/i.test(ua))return;
      var langs=(navigator.languages&&navigator.languages.length)?navigator.languages:[navigator.language||''];
      var prefersGerman=langs.some(function(l){return l.toLowerCase().indexOf('de')===0;});
      if(prefersGerman)window.location.replace('${BASE}de/');
    }catch(e){}})();`} />
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preload" href={interLatin300} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin>
  <meta name="description" content={description}>
  <meta name="generator" content={Astro.generator}>
  <meta name="robots" content={robots}>
  <meta name="theme-color" content="#2479BE">
  <!-- Replays the stored contrast scheme before first paint, so someone who needs it never
       sees a flash of the brand colours on navigation (see src/scripts/contrast.ts). -->
  <style is:inline set:html={contrastSchemeCss()} />
  <script is:inline set:html={`try{var s=localStorage.getItem(${JSON.stringify(CONTRAST_STORAGE_KEY)}),g=${JSON.stringify(contrastGrounds)}[s];if(typeof g==='string'){document.documentElement.setAttribute('data-contrast',s);var m=document.querySelector('meta[name="theme-color"]');if(m){m.dataset.brand=m.content;m.content=g}}}catch(e){}`} />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content="Klartext AI">
  <meta property="og:url" content={canonicalHref}>
  <meta property="og:locale" content={locale}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={OG_IMAGE_ALT}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <meta name="twitter:image:alt" content={OG_IMAGE_ALT}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href={`${BASE}favicon.ico`}>
  <link rel="apple-touch-icon" href={`${BASE}LOGO_transparent_without_sublime.png`}>
  <link rel="canonical" href={canonicalHref}>
  <link rel="alternate" hreflang="de" href={deHref}>
  <link rel="alternate" hreflang="en" href={enHref}>
  <link rel="alternate" hreflang="x-default" href={enHref}>

  <title>{title}</title>

  <!-- Custom Cookie Consent Styling -->
  <style is:global>
    /* Vanilla CookieConsent theming to align with Klartext glass/blue look */
    #cc-main {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
      z-index: 9999;
      /* Theme tokens inspired by cookieconsent light-funky, tuned to our brand blues */
      --cc-bg: var(--glass-bg-solid);
      --cc-primary-color: var(--color-blue);
      --cc-secondary-color: var(--color-blue);
      --cc-btn-primary-bg: var(--color-blue);
      --cc-btn-primary-color: var(--color-on-fill);
      --cc-btn-primary-hover-bg: color-mix(in srgb, var(--color-blue) 90%, var(--color-surface));
      --cc-btn-primary-hover-color: var(--color-on-fill);
      --cc-btn-primary-border-color: transparent;
      --cc-btn-primary-hover-border-color: transparent;
      --cc-btn-secondary-bg: var(--color-blue-tint);
      --cc-btn-secondary-color: var(--color-blue);
      --cc-btn-secondary-hover-bg: var(--color-blue-tint-strong);
      --cc-btn-secondary-hover-color: var(--color-blue);
      --cc-btn-secondary-border-color: transparent;
      --cc-btn-secondary-hover-border-color: transparent;
      --cc-cookie-category-block-bg: var(--glass-bg-solid);
      --cc-cookie-category-block-border: var(--color-line-blue-strong);
      --cc-cookie-category-block-hover-bg: var(--color-surface);
      --cc-cookie-category-block-hover-border: var(--color-line-blue-strong);
      --cc-footer-bg: transparent;
      --cc-footer-border-color: transparent;
      --cc-btn-border-radius: 12px;
      --cc-modal-border-radius: 16px;
    }

    #cc-main .cm {
      background: var(--glass-bg-strong) !important;
      backdrop-filter: blur(24px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      color: var(--color-text-body);
      border-radius: 16px;
    }

    #cc-main .pm {
      background: var(--color-surface) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      color: var(--color-text-body);
      border-radius: 16px;
    }

    #cc-main .cm__title,
    #cc-main .pm__title {
      color: var(--color-text-dark);
      letter-spacing: -0.01em;
    }

    #cc-main .cm__desc,
    #cc-main .pm__desc,
    #cc-main .pm__section-desc {
      color: var(--color-text-body);
      line-height: 1.55;
    }

    #cc-main .cc__link,
    #cc-main .pm a {
      color: var(--color-blue);
    }

    #cc-main .cm__btns .cc-btn,
    #cc-main .pm__btn-group .cc-btn,
    #cc-main .cm__btn {
      border: none !important;
      border-radius: 12px;
      padding: 0.75rem 1.4rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    #cc-main .cc-btn.cc-btn-primary,
    #cc-main .cm__btns .cc-btn.cc-btn-primary {
      background: var(--color-blue);
      color: var(--color-on-fill) !important;
      border: none !important;
      outline: none !important;
      box-shadow: var(--shadow-md);
    }

    #cc-main .cc-btn.cc-btn-primary:hover {
      background: var(--color-blue);
      transform: translateY(-1px);
      border: none !important;
    }

    #cc-main .cc-btn.cc-btn-secondary,
    #cc-main .cc-btn.cc-btn-outline,
    #cc-main .cm__btns .cc-btn.cc-btn-secondary,
    #cc-main .cm__btns .cc-btn.cc-btn-outline {
      background: var(--color-blue-tint);
      color: var(--color-blue) !important;
      border: none !important;
      outline: none !important;
      box-shadow: none;
    }

    #cc-main .cc-btn.cc-btn-secondary:hover,
    #cc-main .cc-btn.cc-btn-outline:hover {
      background: var(--color-blue-tint);
      border: none !important;
      color: var(--color-blue);
    }

    #cc-main .pm__badge {
      background: var(--color-blue-tint);
      color: var(--color-blue);
    }

    #cc-main .cm__btns,
    #cc-main .pm__btns {
      border-top: 1px solid var(--color-line-blue-strong) !important;
      padding-top: 1rem !important;
    }

    /* Slide-in animation for consent modal */
    #cc-main .cm {
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
    }

    #cc-main .cm.cc-hidden {
      transform: translateY(150%) !important;
      opacity: 0 !important;
      pointer-events: none;
    }

    #cc-main .cm:not(.cc-hidden) {
      transform: translateY(0) !important;
      opacity: 1 !important;
    }

    /* Preferences modal section styling - clean white backgrounds */
    #cc-main .pm__section {
      background: var(--glass-bg-solid) !important;
      border: 1px solid var(--color-line-blue) !important;
      padding: 1.25rem !important;
      border-radius: 12px !important;
    }

    #cc-main .pm__section:hover {
      background: var(--color-surface) !important;
    }

    #cc-main .pm__section-title {
      margin-bottom: 0.5rem !important;
    }

    #cc-main .pm__section-desc {
      margin-bottom: 0 !important;
    }

    /* Contrast schemes: the banner's buttons are borderless tints, which would flatten into
       plain text on the page colour, so each one draws its edge. The toggles keep the library's
       light-theme colours unless remapped (a white knob on a white track in white-on-black):
       on is a text-coloured track with a page-coloured knob, off the reverse, each outlined.
       The always-on toggle for necessary cookies reads as on. */
    html[data-contrast] #cc-main :is(.cm__btn, .pm__btn),
    html[data-contrast] #cc-main .pm__section {
      border: 1px solid var(--hc-fg) !important;
    }

    html[data-contrast] #cc-main {
      --cc-toggle-on-bg: var(--hc-fg);
      --cc-toggle-on-knob-bg: var(--hc-bg);
      --cc-toggle-enabled-icon-color: var(--hc-fg);
      --cc-toggle-off-bg: var(--hc-bg);
      --cc-toggle-off-knob-bg: var(--hc-fg);
      --cc-toggle-disabled-icon-color: var(--hc-bg);
      --cc-toggle-readonly-bg: var(--hc-fg);
      --cc-toggle-readonly-knob-bg: var(--hc-bg);
      --cc-toggle-readonly-knob-icon-color: var(--hc-fg);
    }

    html[data-contrast] #cc-main .toggle__icon {
      box-shadow: 0 0 0 1px var(--hc-fg);
    }

    /* The section expand arrow borrows the always-on toggle's track colour for its circle,
       which would put its text-coloured stroke on a text-coloured disc. */
    html[data-contrast] #cc-main .pm__section-arrow {
      background: var(--hc-bg);
      box-shadow: 0 0 0 1px var(--hc-fg);
    }

    /* Mobile responsive adjustments */
    @media (max-width: 768px) {
      #cc-main .cm__title,
      #cc-main .cm__desc {
        text-align: center !important;
        text-wrap: balance !important;
      }
    }
  </style>

  <!-- Structured Data: Organization + WebSite + WebPage -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': ORGANIZATION_ID,
        'name': 'Klartext AI',
        'legalName': 'Klartext AI FlexCo',
        'alternateName': 'Klartext',
        'url': SITE,
        'logo': new URL(`${BASE}LOGO_transparent.png`, SITE).toString(),
        'description': lang === 'en'
          ? 'Klartext AI builds custom AI solutions for document processing, process automation, and agentic systems — with measurable ROI and a focus on domain expertise.'
          : 'Klartext AI entwickelt individuelle KI-Lösungen für Dokumentenverarbeitung, Prozessautomatisierung und agentische Systeme – mit messbarem ROI und Fokus auf fachlicher Exzellenz.',
        'foundingDate': '2025',
        'foundingLocation': { '@type': 'Place', 'name': lang === 'en' ? 'Vienna, Austria' : 'Wien, Österreich' },
        'founder': founderSchema(lang),
        'vatID': 'ATU81693669',
        'knowsAbout': lang === 'en'
          ? ['Custom AI development', 'Agentic AI', 'Document processing', 'Data extraction from PDFs', 'PDF accessibility (PDF/UA, WCAG)', 'Process automation', 'Human-in-the-loop AI', 'AI evaluation', 'Explainable and auditable AI', 'EU AI Act']
          : ['Individuelle KI-Entwicklung', 'Agentische KI', 'Dokumentenverarbeitung', 'Datenextraktion aus PDFs', 'Barrierefreie PDFs (PDF/UA, WCAG)', 'Prozessautomatisierung', 'Human-in-the-Loop', 'KI-Evaluation', 'Erklärbare und nachvollziehbare KI', 'EU AI Act'],
        // The products are described in full on /ventures and the matching success stories.
        'makesOffer': [DOCLARITY_ID, EXTRACT_ID].map((id) => ({ '@type': 'Offer', 'itemOffered': { '@id': id } })),
        // Must stay in sync with the address in Footer.astro and the Impressum.
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': 'Lerchenfelder Straße 74/2/7',
          'postalCode': '1080',
          'addressLocality': lang === 'en' ? 'Vienna' : 'Wien',
          'addressRegion': lang === 'en' ? 'Vienna' : 'Wien',
          'addressCountry': 'AT'
        },
        'sameAs': [
          'https://www.linkedin.com/company/klartext-ai/',
          'https://github.com/Klartext-AI',
          'https://www.wikidata.org/wiki/Q138454516',
          'https://www.crunchbase.com/organization/klartext-ai'
        ],
        'contactPoint': [{
          '@type': 'ContactPoint',
          'contactType': lang === 'en' ? 'customer support' : 'Kundensupport',
          'email': 'office@klartext-ai.com',
          'telephone': '+43 660 81010 67',
          'areaServed': ['AT','DE','EU'],
          'availableLanguage': ['de','en']
        }]
      },
      {
        '@type': 'WebSite',
        '@id': new URL('/#website', SITE).toString(),
        'name': 'Klartext AI',
        'url': SITE,
        'inLanguage': lang,
        'publisher': { '@id': ORGANIZATION_ID }
      },
      {
        '@type': 'WebPage',
        'url': canonicalHref,
        'name': title,
        'description': description,
        'inLanguage': lang,
        'isPartOf': { '@id': new URL('/#website', SITE).toString() }
      },
      ...structuredData
    ]
  })}></script>


  <!-- Preserve the outgoing page's background for the first frame. The new
       page then transitions from that value to its own background state. -->
  <script is:inline>
    (() => {
      try {
        const key = 'klartext-background-mode';
        const previous = sessionStorage.getItem(key);
        // A page of the site was already on screen in this tab, and the navigation with it, so
        // the home page keeps the bar in place instead of fading it in again (see Opening.astro).
        // A reload still plays the full opening.
        if (previous && performance.getEntriesByType('navigation')[0]?.type !== 'reload') {
          document.documentElement.classList.add('nav-settled');
        }
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const current = location.pathname.replace(/\/+$/, '').endsWith('/ecosystem') ? 'plain' : 'gradient';
        if (previous && previous !== current) {
          document.documentElement.style.setProperty('--site-background-opacity', previous === 'plain' ? '0' : '1');
        }
      } catch {}
    })();
  </script>
</head>
<body>
  <div class="site-background" aria-hidden="true"></div>
  <Navigation lang={lang} alwaysVisible={alwaysShowNav} />
  {isProd && GA4_ID && <CookieConsent lang={lang} gaId={GA4_ID} />}
  <!-- The one <main> of every page; pages never bring their own. The footer goes in its own
       slot so it stays outside <main> and keeps the contentinfo landmark. -->
  <main id="page-content" tabindex="-1"><slot /></main>
  <slot name="footer" />

  <!-- Scroll Animation Script -->
  <script>
    // Run callback whether DOMContentLoaded already fired or not
    const runOnReady = (callback: () => void) => {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', callback, { once: true });
      } else {
        callback();
      }
    };

    // Intersection Observer for fade-in animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    // Observe all elements with fade-in class
    runOnReady(() => {
      const fadeElements = document.querySelectorAll('.fade-in');

      if (!fadeElements.length) return;

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, observerOptions);

        fadeElements.forEach(el => {
          // Check if element is already in viewport on page load
          const rect = el.getBoundingClientRect();
          const windowHeight = window.innerHeight || document.documentElement.clientHeight;
          const windowWidth = window.innerWidth || document.documentElement.clientWidth;

          // Element is considered "in viewport" if it's at least partially visible
          const isInViewport = (
            rect.top < windowHeight &&
            rect.bottom > 0 &&
            rect.left < windowWidth &&
            rect.right > 0
          );

          // If already in viewport, make it visible immediately
          if (isInViewport) {
            el.classList.add('visible');
          }

          // Observe for future scroll events
          observer.observe(el);
        });
      } else {
        // Fallback for browsers without IntersectionObserver
        fadeElements.forEach(el => el.classList.add('visible'));
      }
    });
  </script>

  <script>
    const backgroundModeKey = 'klartext-background-mode';
    const isEcosystemPath = (pathname: string) => pathname.replace(/\/+$/, '').endsWith('/ecosystem');
    const currentBackgroundMode = () => isEcosystemPath(location.pathname) ? 'plain' : 'gradient';

    addEventListener('pageshow', () => {
      const currentMode = currentBackgroundMode();
      let previousMode: string | null = null;
      try {
        previousMode = sessionStorage.getItem(backgroundModeKey);
        sessionStorage.setItem(backgroundModeKey, currentMode);
      } catch {}

      if (!previousMode || previousMode === currentMode || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.style.removeProperty('--site-background-opacity');
        return;
      }

      requestAnimationFrame(() => requestAnimationFrame(() => {
        document.documentElement.style.removeProperty('--site-background-opacity');
      }));
    });
  </script>
</body>
</html>
