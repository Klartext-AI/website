---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

const title = 'Careers - Klartext AI';
const description = 'Join Klartext AI and help shape the future of AI with us.';
---

<BaseLayout title={title} description={description} lang="en" alwaysShowNav={true}>
  <div class="karriere-page">
    <div class="container">
      <header class="page-header fade-in">
        <h1>Shape the Future.</h1>
        <p class="tagline">Because AI is not just a buzzword for us.</p>
      </header>

      <!--<section class="vision-section fade-in">-->
      <!--  <div class="vision-content glass-card">-->
      <!--    <p class="vision-intro">It is the year 2300.</p>-->
      <!--    <p>The world is not like today.</p>-->
      <!--    <p>It is automated.</p>-->
      <!--    <p>It is intelligent.</p>-->
      <!--    <p>It is futuristic.</p>-->
      <!--    <p class="vision-statement">Klartext AI stands for nothing less than the future of our world.</p>-->
      <!--  </div>-->
      <!--</section>-->

      <section class="vision-section fade-in">
        <div class="vision-content glass-card">
          <p class="lead">You want to implement your own ideas, turn visions into reality, and value teamwork – then you're one of us!</p>
          <p class="cta-text">Find your opportunities below or apply proactively.</p>
        </div>
      </section>

      <section class="jobs-section">
        <h2 class="section-title fade-in">We are currently looking for:</h2>

        <article class="job-card fade-in glass-card">
          <button class="job-header" data-job-toggle>
            <div class="job-header-content">
              <h3 class="job-title">Full-Stack Engineer – AI & DevOps</h3>
              <div class="job-meta">
                <span class="job-type">m/f/d</span>
                <span class="job-mode">Full-time</span>
              </div>
            </div>
            <svg class="expand-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="job-content" data-job-content>
            <p class="job-intro">At Klartext AI, we build AI solutions, products and ventures that move beyond prototypes and into real business use. We are looking for someone who can help us build, ship and scale AI products end-to-end – from frontend and backend to infrastructure, deployment and production reliability.</p>

            <p>We care about judgment more than job titles. That means someone highly autonomous, able to sit in front of a client and translate what they need into what gets built, with enough experience owning systems end to end to know which trade-offs matter – and enough judgment to steer AI tools like Claude Code rather than follow them. Ten years inside one specific framework is explicitly not what we are after.</p>

            <div class="job-section">
              <h4>What you’ll do:</h4>
              <ul>
                <li>Build AI-powered web applications <strong>from prototype to production</strong></li>
                <li>Develop <strong>backend systems, APIs</strong>, integrations and automation workflows</li>
                <li>Create clean and intuitive frontend experiences</li>
                <li><strong>Talk directly to clients</strong> and translate what they need into technical decisions</li>
                <li>Work with <strong>LLMs</strong>, <strong>AI workflows</strong> and production-grade AI applications</li>
                <li>Own <strong>DevOps</strong> topics like <strong>deployment</strong>, <strong>CI/CD</strong>, <strong>cloud infrastructure</strong> and <strong>monitoring</strong></li>
                <li>Shape <strong>technical architecture</strong> and take ownership of implementation quality</li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we’re looking for:</h4>
              <ul>
                <li>A <strong>highly autonomous, pragmatic way of working</strong> – you set your own priorities and move things forward without being managed</li>
                <li>Experience <strong>owning systems end to end</strong>: from the first conversation through production and everything after</li>
                <li>Solid full-stack experience, primarily in <strong>TypeScript (Next.js, TanStack, Tailwind and friends)</strong> – <strong>judgment matters more to us than years inside a single framework</strong></li>
                <li>Experience with <strong>Python (FastAPI)</strong>, which we use selectively for backend and AI services</li>
                <li>Interest in <strong>AI</strong>, <strong>LLMs</strong> and <strong>AI SDKs</strong> – plus the judgment to steer AI coding tools like <strong>Claude Code</strong> and know where to take them</li>
                <li>Confident with <strong>Docker</strong> and <strong>VM management</strong>; <strong>Kubernetes</strong> is a plus – or the willingness to learn it</li>
                <li><strong>DevOps</strong> experience or strong motivation to grow deeper into <strong>infrastructure</strong></li>
                <li>Interest in startups, product building and fast-moving environments</li>
                <li>Fluent <strong>English</strong>. <strong>German is a big plus.</strong></li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we offer:</h4>
              <ul>
                <li>Direct impact on real AI products and ventures</li>
                <li>Close collaboration with founders, clients and the team</li>
                <li>Ownership across product, AI, architecture and infrastructure</li>
                <li>Beautiful office in Vienna’s 8th district, flexible working hours and hybrid work</li>
                <li>A young, ambitious and entrepreneurial team</li>
              </ul>
            </div>

            <p class="job-outro">We are looking for someone who doesn’t just want to write code, but wants to build, ship and scale what’s next with AI.</p>
            <div class="job-contact-info">
                <p>Send us a short intro and your CV at <a href="mailto:office@klartext-ai.com" class="email-link">office@klartext-ai.com</a> – we look forward to hearing from you!</p>
            </div>
          </div>
        </article>

        <article class="job-card fade-in glass-card">
          <button class="job-header" data-job-toggle>
            <div class="job-header-content">
              <h3 class="job-title">Founders’ Associate – AI Ventures & Growth</h3>
              <div class="job-meta">
                <span class="job-type">m/f/d</span>
                <span class="job-mode">Full-time / Part-time</span>
              </div>
            </div>
            <svg class="expand-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="job-content" data-job-content>
            <p class="job-intro">Klartext AI is one of Vienna’s fastest-growing AI Venture Studios. We build AI solutions for companies and turn promising ideas into products, businesses and new ventures. We are looking for a highly entrepreneurial Founders’ Associate to work closely with our founders and help shape what comes next.</p>

            <p>This is a highly flexible role. Your work can look very different from one day to the next — from business development and customer acquisition to marketing, product development, project management or exploring a new venture. You will have the freedom to identify opportunities, propose your own ideas and turn them into reality.</p>

            <div class="job-section">
              <h4>What you’ll do:</h4>
              <ul>
                <li><strong>Work directly with founders</strong> across <strong>BD, sales, marketing, product and venture building</strong></li>
                <li>Research opportunities, lead customer conversations and outreach</li>
                <li>Help launch <strong>new AI products and ventures</strong>, from idea to execution</li>
                <li>Bring your own ideas – and the freedom to build them</li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we’re looking for:</h4>
              <ul>
                <li><strong>Entrepreneurial mindset</strong>, high ownership, bias towards action</li>
                <li>You spot what needs doing – you don’t just execute</li>
                <li>Interest in AI, startups and venture building</li>
                <li>Ideally you’ve <strong>already built something yourself</strong></li>
                <li>Fluent in <strong>English and German</strong></li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we offer:</h4>
              <ul>
                <li>Work at Vienna’s fastest-growing AI Venture Studio</li>
                <li>Direct access to the founders and real influence</li>
                <li><strong>High autonomy</strong>, flexible hours and hybrid work</li>
                <li>The chance to <strong>eventually lead and build your own AI venture, including shares</strong></li>
                <li>A young, ambitious team with flat hierarchies</li>
              </ul>
            </div>

            <p class="job-outro">We are not looking for someone who executes tasks. We are looking for someone who wants to build something themselves one day, and brings the ideas and vision to prove it.</p>
            <div class="job-contact-info">
                <p>Send a short intro, a hello or your CV to <a href="mailto:office@klartext-ai.com" class="email-link">office@klartext-ai.com</a> – we look forward to hearing from you!</p>
            </div>
          </div>
        </article>

        <article class="job-card fade-in glass-card">
          <button class="job-header" data-job-toggle>
            <div class="job-header-content">
              <h3 class="job-title">Creative Marketing &amp; Content Creation</h3>
              <div class="job-meta">
                <span class="job-type">m/f/d</span>
                <span class="job-mode">Part-time / approx. 8h per week</span>
              </div>
            </div>
            <svg class="expand-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="job-content" data-job-content>
            <p class="job-intro">You don’t want to ship individual posts – you want to build a brand? We are a team of ten with solid growth, looking for someone to shape how we look and sound: visual language, tone and recognisability across every channel, from LinkedIn to graphics to our website. A great fit alongside your studies.</p>

            <div class="job-section">
              <h4>What you’ll do:</h4>
              <ul>
                <li><strong>Brand building</strong>: sharpen our visual language, tone and recognisability – and keep them consistent across every channel</li>
                <li><strong>Graphic design</strong> for web, flyers, roll-ups, presentations and social media</li>
                <li>Concept, write and design our <strong>LinkedIn posts</strong></li>
                <li>Maintain and extend our <strong>website</strong> – with <strong>Claude Code</strong>, no classic coding required</li>
                <li><strong>Campaigns and marketing ideas</strong> – develop them and run with them yourself</li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we’re looking for:</h4>
              <ul>
                <li>A feel for <strong>brands</strong> – and an eye for clean, sleek design</li>
                <li>Confident with common design tools (<strong>Canva</strong>, <strong>Figma</strong>, <strong>Adobe CC</strong> or similar)</li>
                <li>Fluent <strong>English is a requirement</strong> (LinkedIn posts, marketing material). German is very welcome but not a strict requirement.</li>
                <li>Interest in AI, startups, storytelling and <strong>brand building</strong></li>
                <li>Ownership – we trust you to drive your own topics forward</li>
                <li>Curiosity about tools like <strong>Claude Code</strong>; prior experience is not required</li>
              </ul>
            </div>

            <div class="job-section">
              <h4>What we offer:</h4>
              <ul>
                <li><strong>Marginal employment (“geringfügig”) on an approx. 8h basis</strong> – some weeks more, some less</li>
                <li>A team of ten with flat hierarchies and healthy growth</li>
                <li>A nice office in Vienna’s 8th district, darts board included – we love it when you show up</li>
                <li>No rigid rules on home office or working hours: we trust people to get their work done</li>
                <li>The chance to shape a young brand from the ground up – not just maintain it</li>
              </ul>
            </div>

            <p class="job-outro">We want to deliver quality like the “Apple of AI engineering” – in design just as much as in engineering. If that sounds like something you want to shape, we’d love to hear from you.</p>
            <div class="job-contact-info">
                <p>Send us a short intro and – if you have them – a few work samples or your portfolio at <a href="mailto:office@klartext-ai.com" class="email-link">office@klartext-ai.com</a> – we look forward to hearing from you!</p>
            </div>
          </div>
        </article>
      </section>

      <section class="tech-stack-section fade-in">
        <div class="tech-stack-card glass-card">
          <h3>Our Tech Stack</h3>
          <div class="tech-tags">
            <span class="tech-tag">TypeScript (Next.js, React, TanStack, Tailwind)</span>
            <span class="tech-tag">Python (FastAPI)</span>
            <span class="tech-tag">Docker</span>
            <span class="tech-tag">VM Management</span>
            <span class="tech-tag">Kubernetes</span>
            <span class="tech-tag">Cloud (Vercel, Supabase, AWS, GCP, Azure)</span>
            <span class="tech-tag">AI SDKs & LLM APIs (OpenAI, Anthropic, etc.)</span>
          </div>
        </div>
      </section>

      <section class="contact-section fade-in">
        <div class="contact-card glass-card">
          <h2>Interested?</h2>
          <p>Get in touch at <a href="mailto:office@klartext-ai.com" class="email-link">office@klartext-ai.com</a> – we look forward to hearing from you!</p>
        </div>
      </section>
    </div>
  </div>
  <Footer lang="en" />
</BaseLayout>

<style>
  .karriere-page {
    min-height: calc(100vh - 80px);
    padding: calc(60px + var(--space-lg)) 0 var(--space-lg);
    background: transparent;
    margin-top: var(--space-xl);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    margin-bottom: var(--space-md);
    color: var(--color-text-dark);
  }

  .tagline {
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .vision-section {
    margin-bottom: var(--space-2xl);
  }

  .vision-content {
    padding: var(--space-xl);
    text-align: center;
    border-radius: 16px;
  }

  .vision-content p {
    font-size: 1.375rem;
    line-height: 1.8;
    color: var(--color-text-body);
    margin-bottom: var(--space-sm);
  }

  .vision-intro {
    font-size: 1.5rem !important;
    font-weight: 500;
    color: var(--color-blue);
    margin-bottom: var(--space-md) !important;
  }

  .vision-statement {
    font-size: 1.5rem !important;
    font-weight: 600;
    color: var(--color-text-dark);
    margin-top: var(--space-lg) !important;
    margin-bottom: 0 !important;
  }

  .intro-section {
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .intro-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-text-body);
    margin-bottom: var(--space-xl);
  }

  .role-highlights {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
    flex-wrap: wrap;
  }

  .role-item {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-blue);
    padding: var(--space-sm) var(--space-lg);
    background: rgba(36, 121, 190, 0.08);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .role-item:hover {
    background: rgba(36, 121, 190, 0.15);
    transform: translateY(-2px);
  }

  .cta-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .jobs-section {
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text-dark);
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .job-card {
    margin-bottom: var(--space-xl);
    border-radius: 16px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .job-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px -12px rgba(36, 121, 190, 0.3);
  }

  .job-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: transparent;
    border: none;
    border-bottom: 2px solid rgba(36, 121, 190, 0.15);
    cursor: pointer;
    text-align: left;
    transition: background 0.3s ease;
  }

  .job-header:hover {
    background: rgba(36, 121, 190, 0.05);
  }

  .job-header-content {
    flex: 1;
  }

  .expand-icon {
    flex-shrink: 0;
    color: var(--color-blue);
    transition: transform 0.3s ease;
  }

  .job-card.expanded .expand-icon {
    transform: rotate(180deg);
  }

  .job-title {
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-text-dark);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .job-meta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .job-type,
  .job-mode {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-blue);
    padding: 0.375rem 0.875rem;
    background: rgba(36, 121, 190, 0.1);
    border-radius: 6px;
  }

  .job-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-body);
    padding: 0 var(--space-xl);
  }

  .job-card.expanded .job-content {
    max-height: 4000px;
    padding: var(--space-lg);
  }

  .job-intro {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: var(--space-lg);
    color: var(--color-text-dark);
  }

  .job-section {
    margin-bottom: var(--space-lg);
  }

  .job-content strong {
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .job-section h4 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-blue);
    margin-bottom: var(--space-md);
  }

  .job-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .job-section li {
    position: relative;
    padding-left: var(--space-lg);
    margin-bottom: 0.25rem;
    line-height: 1.45;
  }

  .job-section li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-blue);
    font-weight: 600;
  }

  .job-outro {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-blue);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(36, 121, 190, 0.15);
  }

  .tech-stack-section {
    margin-bottom: var(--space-2xl);
  }

  .tech-stack-card {
    padding: var(--space-lg);
    border-radius: 16px;
    text-align: center;
  }

  .tech-stack-card h3 {
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-text-dark);
    margin-bottom: var(--space-lg);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .tech-tag {
    font-size: 0.9375rem;
    font-weight: 500;
    color: white;
    background: var(--color-blue);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .tech-tag:hover {
    background: var(--color-blue-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(36, 121, 190, 0.3);
  }

  .tech-stack-card h4 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-blue);
    margin-bottom: var(--space-md);
  }

  .tech-stack-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-body);
  }

  .contact-section {
    margin-bottom: var(--space-xl);
  }

  .contact-card {
    padding: var(--space-2xl);
    border-radius: 16px;
    text-align: center;
  }

  .contact-card h2 {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text-dark);
    margin-bottom: var(--space-md);
  }

  .contact-card p {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-text-body);
  }

  .email-link {
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border-bottom: 2px solid transparent;
  }

  .email-link:hover {
    color: var(--color-blue-accent);
    border-bottom-color: var(--color-blue-accent);
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 24px -6px rgba(36, 121, 190, 0.18);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 0;
    animation: fadeIn 0.8s ease forwards;
  }

  .fade-in:nth-child(1) { animation-delay: 0.1s; }
  .fade-in:nth-child(2) { animation-delay: 0.2s; }
  .fade-in:nth-child(3) { animation-delay: 0.3s; }
  .fade-in:nth-child(4) { animation-delay: 0.4s; }
  .fade-in:nth-child(5) { animation-delay: 0.5s; }

  @media (max-width: 768px) {
    .karriere-page {
      padding: calc(60px + var(--space-lg)) 0 var(--space-lg);
    }

    .container {
      padding: 0 var(--space-sm);
    }

    .page-header h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.125rem;
    }

    .vision-content p {
      font-size: 1.125rem;
    }

    .vision-content {
      padding: var(--space-lg) var(--space-md);
    }

    .role-highlights {
      flex-direction: column;
      align-items: center;
    }

    .role-item {
      width: 100%;
      max-width: 320px;
      padding: var(--space-sm) var(--space-md);
      font-size: 1rem;
    }

    .job-title {
      font-size: 1.375rem;
    }

    .job-type,
    .job-mode {
      padding: 0.25rem 0.625rem;
      font-size: 0.875rem;
    }

    .job-content {
      padding: 0 var(--space-sm);
      font-size: 1rem;
    }

    .job-card.expanded .job-content {
      padding: var(--space-sm);
    }

    .job-section li {
      padding-left: var(--space-md);
    }

    .tech-tags {
      gap: var(--space-xs);
    }

    .tech-tag {
      font-size: 0.875rem;
      padding: 0.375rem 0.75rem;
    }

    .tech-stack-card {
      padding: var(--space-sm);
    }

    .contact-card {
      padding: var(--space-md);
    }

    .job-header {
      padding: var(--space-sm);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const jobToggles = document.querySelectorAll('[data-job-toggle]');

    jobToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const jobCard = toggle.closest('.job-card');
        jobCard?.classList.toggle('expanded');
      });
    });
  });
