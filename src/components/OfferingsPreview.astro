---
interface Props {
  lang?: 'de' | 'en';
}

import Icon from './Icon.astro';

const { lang = 'de' } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const content = {
  de: {
    sectionTitle: "Was wir anbieten",
    subtitle: "Maßgeschneiderte Lösungen für Deine KI-Transformation",
    viewAllOfferings: "Alle Leistungen ansehen",
    learnMore: "Mehr erfahren",
    offerings: [
      {
        id: "custom-projects",
        title: "Kundenspezifische Projekte",
        icon: "🎯",
        description: "Maßgeschneiderte AI-Lösungen mit nachweisbarem ROI",
        highlights: ["Domain-Driven", "End-to-End", "Messbare Erfolge"]
      },
      {
        id: "workshops",
        title: "Workshops",
        icon: "🎓",
        description: "Strukturierte Workshops von Value Sprint bis Security Screening",
        highlights: ["AI Value Sprint", "EU AI Act Readiness", "Security Screening"]
      },
      {
        id: "pdf-accessibility",
        title: "doclarity – PDF/UA Accessibility",
        icon: "📄",
        description: "KI-gestützte Umwandlung von PDFs in barrierefreie PDF/UA-Dokumente",
        highlights: ["KI-gestützte Transformation", "Human-in-the-Loop-Review", "Geprüfte PDF/UA-Konformität"]
      },
      {
        id: "inspirational-talks",
        title: "Inspirational Talks",
        icon: "💡",
        description: "Praxisnahe Einblicke in erfolgreiche AI-Transformationen",
        highlights: ["Success Stories", "Best Practices", "Interaktive Q&A"]
      }
    ]
  },
  en: {
    sectionTitle: "What We Offer",
    subtitle: "Tailored solutions for your AI transformation",
    viewAllOfferings: "View all services",
    learnMore: "Learn more",
    offerings: [
      {
        id: "custom-projects",
        title: "Custom Projects",
        icon: "🎯",
        description: "Tailored AI solutions with demonstrable ROI",
        highlights: ["Domain-Driven", "End-to-End", "Measurable Results"]
      },
      {
        id: "workshops",
        title: "Workshops",
        icon: "🎓",
        description: "Structured workshops from Value Sprint to Security Screening",
        highlights: ["AI Value Sprint", "EU AI Act Readiness", "Security Screening"]
      },
      {
        id: "pdf-accessibility",
        title: "doclarity – PDF/UA Accessibility",
        icon: "📄",
        description: "AI-assisted conversion of PDFs into accessible PDF/UA documents",
        highlights: ["AI-assisted transformation", "Human-in-the-loop review", "Verified PDF/UA compliance"]
      },
      {
        id: "inspirational-talks",
        title: "Inspirational Talks",
        icon: "💡",
        description: "Practical insights into successful AI transformations",
        highlights: ["Success Stories", "Best Practices", "Interactive Q&A"]
      }
    ]
  }
} as const;

const text = content[lang];

const offeringIcons = {
  workshops: 'graduation',
  'custom-projects': 'target',
  'pdf-accessibility': 'route',
  'inspirational-talks': 'bulb'
} as const;

const offeringLogos: Record<string, string> = {
  'pdf-accessibility': `${BASE}doclarity_product_files/doclarity-logo.svg`
};

const linkMap: Record<string, string> = {
  'pdf-accessibility': lang === 'en' ? `${BASE}en/success-stories/doclarity` : `${BASE}success-stories/doclarity`,
};
---

<section class="offerings-preview section">
  <div class="container">
    <div class="section-header fade-in text-center">
      <h2>{text.sectionTitle}</h2>
      <p class="section-subtitle">{text.subtitle}</p>
    </div>

    <div class="offerings-grid">
      {text.offerings.map((offering, index) => {
        const isLinked = offering.id in linkMap;
        const href = linkMap[offering.id];
        const Tag = isLinked ? 'a' : 'article';
        return (
        <Tag
          class:list={['offering-preview-card', 'glass-card', 'fade-in', { 'offering-preview-card--linked': isLinked }]}
          style={`animation-delay: ${index * 0.1}s`}
          {...(isLinked ? { href } : {})}
        >
          <div class="offering-icon-large">
            {offeringLogos[offering.id] ? (
              <img
                src={offeringLogos[offering.id]}
                alt=""
                class="offering-brand-logo"
                width="126"
                height="32"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Icon name={offeringIcons[offering.id]} size={36} />
            )}
          </div>
          <h3 class="offering-preview-title">{offering.title}</h3>
          <p class="offering-preview-description">{offering.description}</p>

          <ul class="offering-preview-highlights">
            {offering.highlights.map((highlight) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8l3 3 7-7" stroke="var(--color-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {highlight}
              </li>
            ))}
          </ul>

          {isLinked && (
            <span class="offering-preview-link">
              {text.learnMore}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 12l4-4-4-4"/>
              </svg>
            </span>
          )}
        </Tag>
        );
      })}
    </div>

    <div class="offerings-cta text-center fade-in">
      <a href={lang === 'de' ? `${BASE}leistungen` : `${BASE}en/services`} class="btn btn-secondary">
        {text.viewAllOfferings}
      </a>
    </div>
  </div>
</section>

<style>
  .offerings-preview {
    position: relative;
    background: transparent;
  }

  .offerings-preview .section-subtitle {
    margin-left: auto;
    margin-right: auto;
    max-width: 800px;
    text-align: center;
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    max-width: 1480px;
    margin: 0 auto;
    margin-bottom: var(--space-xl);
  }

  .offering-preview-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-md);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(20px) saturate(160%);
  }

  .offering-preview-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px -10px rgba(36, 121, 190, 0.3);
    background: rgba(255, 255, 255, 0.75) !important;
  }

  .offering-preview-card--linked {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .offering-preview-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-blue);
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.3s ease;
    margin-top: var(--space-sm);
  }

  .offering-preview-card--linked:hover .offering-preview-link {
    gap: 0.75rem;
  }

  .offering-preview-link svg {
    transition: transform 0.3s ease;
  }

  .offering-preview-card--linked:hover .offering-preview-link svg {
    transform: translateX(4px);
  }

  .offering-icon-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-blue);
    margin-bottom: var(--space-sm);
  }

  .offering-brand-logo {
    display: block;
    width: 126px;
    height: auto;
  }

  .offering-preview-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: var(--space-sm);
    color: var(--color-text-dark);
  }

  .offering-preview-description {
    font-size: 0.9rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  .offering-preview-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .offering-preview-highlights li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .offering-preview-highlights li svg {
    flex-shrink: 0;
  }

  .offerings-cta {
    margin-top: var(--section-cta-gap);
  }

  @media (max-width: 1200px) {
    .offerings-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .offerings-grid {
      grid-template-columns: 1fr;
    }

    .section-subtitle {
      font-size: 1.25rem;
    }

    .offering-preview-title {
      font-size: 1.25rem;
    }

    .offering-preview-description {
      font-size: 0.9rem;
    }

    .offering-icon-large {
      font-size: 2.5rem;
    }
  }
</style>
