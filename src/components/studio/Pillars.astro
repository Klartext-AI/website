---
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const de = lang === 'de';
const root = `${import.meta.env.BASE_URL}${de ? 'de/' : ''}`;
const pillars = [
  { name: 'Research', eyebrow: de ? 'Wissen schaffen' : 'Create knowledge', detail: de ? 'Autonomie, Evaluation und verlässliche KI.' : 'Autonomy, evaluation, and reliable AI.', href: `${root}research/` },
  { name: 'Solutions', eyebrow: de ? 'In die Praxis bringen' : 'Put AI to work', detail: de ? 'Von der ersten Idee bis in Deine Systeme.' : 'From the first idea into your systems.', href: `${root}${de ? 'leistungen' : 'services'}/` },
  { name: 'Ventures', eyebrow: de ? 'Unternehmen bauen' : 'Build companies', detail: de ? 'Aus eigener Forschung werden eigenständige Produkte.' : 'Independent products born from our research.', href: `${root}ventures/` },
];
---
<section class="studio-section home-pillars" id="solutions" aria-labelledby="pillars-title">
  <h2 id="pillars-title">{de ? 'Drei Säulen.' : 'Three pillars.'}</h2>
  <div class="pillar-grid">
    {pillars.map(pillar => <a class:list={['build-pillar', { 'build-pillar-core': pillar.name === 'Solutions' }]} href={pillar.href}>
      <span class="kicker">{pillar.eyebrow}<span aria-hidden="true">↗</span></span>
      <h3 lang="en">{pillar.name}</h3>
      <p class="build-pillar-detail">{pillar.detail}</p>
    </a>)}
  </div>
</section>
<style>
  .pillar-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 50px; }
  .build-pillar {
    display: grid; grid-template-columns: 1fr; grid-template-rows: auto auto 1fr;
    position: relative; isolation: isolate;
    padding: 28px 20px; border-top: 1px solid var(--color-line); color: var(--color-text-dark);
  }
  .build-pillar .kicker { grid-area: 1 / 1; display: flex; justify-content: space-between; gap: 16px; }
  .build-pillar h3 { grid-area: 2 / 1; margin-bottom: 24px; font-size: clamp(27px, 2.4vw, 40px); }
  .build-pillar-detail { grid-area: 3 / 1; font-size: 17px; color: var(--color-text-muted); }
  .build-pillar-core { border-top: 2px solid var(--color-blue); background: var(--color-blue-soft); }
  .build-pillar-core h3 { color: var(--color-blue); }
  @media (hover: hover) and (pointer: fine) {
    /* Space for the detail is always reserved, so nothing below the section moves.
       The blue panel is painted by two pseudo-elements instead: the head is static,
       the detail row grows from its top edge as the text fades in. */
    .build-pillar-detail { opacity: 0; transition: opacity .2s ease-out; }
    .build-pillar:hover .build-pillar-detail, .build-pillar:focus-visible .build-pillar-detail { opacity: 1; }
    .build-pillar-core { background: none; }
    .build-pillar-core::before, .build-pillar-core::after {
      content: ''; grid-column: 1; z-index: -1; background: var(--color-blue-soft);
    }
    .build-pillar-core::before { grid-area: 1 / 1 / 3 / 2; margin: -28px -20px 0; }
    .build-pillar-core::after {
      grid-area: 3 / 1; margin: 0 -20px -28px;
      transform: scaleY(0); transform-origin: top; transition: transform .25s ease-out;
    }
    .build-pillar-core:hover::after, .build-pillar-core:focus-visible::after { transform: scaleY(1); }
  }
  @media (max-width: 700px) { .pillar-grid { grid-template-columns: 1fr; gap: 24px; } }
  @media (prefers-reduced-motion: reduce) {
    .build-pillar-detail, .build-pillar-core::after { transition: none; }
  }
</style>