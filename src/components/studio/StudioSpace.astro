---
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const de = lang === 'de';
const base = import.meta.env.BASE_URL;
// The source is 4:3; the frame crops it to 3:2 from slightly above centre, which keeps the
// mezzanine meeting room at the top and drops only floor at the bottom. Full frame on phones.
---
<figure class="studio-space">
  <img
    src={`${base}studio/office-2000.webp`}
    srcset={`${base}studio/office-1000.webp 1000w, ${base}studio/office-2000.webp 2000w`}
    sizes="(min-width: 1280px) 1120px, 100vw"
    width="2000"
    height="1500"
    loading="lazy"
    decoding="async"
    alt={de
      ? 'Das Klartext-Studio in Wien: rechts arbeitet ein Entwickler an zwei Bildschirmen vor einer Holzlamellenwand, links die Logowand und das verglaste Besprechungszimmer im Obergeschoss, davor liegt Bürohund Bruno auf dem Boden.'
      : 'The Klartext studio in Vienna: on the right a developer works at two screens in front of a slatted wood wall, on the left the logo wall and the glazed meeting room on the mezzanine, with office dog Bruno lying on the floor.'} />
  <figcaption>{de ? 'Unser Studio in Wien. Mit Bruno, unserem Chief Happiness Officer.' : 'Our studio in Vienna. With Bruno, our Chief Happiness Officer.'}</figcaption>
</figure>

<style>
  .studio-space { margin: 55px 0 0; }
  .studio-space img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 16px;
  }
  .studio-space figcaption { margin-top: 14px; font-size: 14px; color: var(--color-text-muted); }
  @media (max-width: 600px) {
    .studio-space { margin-top: 40px; }
    .studio-space img { aspect-ratio: 4 / 3; border-radius: 12px; }
  }
</style>
