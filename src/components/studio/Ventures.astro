---
interface Props { lang: 'de' | 'en'; full?: boolean }
const { lang, full = false } = Astro.props;
const Heading = full ? 'h1' : 'h2';
const CardHeading = full ? 'h2' : 'h3';
const de = lang === 'de';
const base = import.meta.env.BASE_URL;
const root = `${base}${de ? 'de/' : ''}`;
const ventures = [
  {name:'doclarity', theme:'doclarity', logo:'ventures/doclarity.svg', status:de ? 'In Gründung' : 'In founding', title:de ? 'Barrierefreie Dokumente. Für alle.' : 'Accessible documents. Built for everyone.', copy:de ? 'Das Expertentool für barrierefreie PDFs. KI macht die Arbeit einfacher und schneller. Fachpersonen prüfen und geben frei.' : 'The expert tool for accessible PDFs. AI makes the work easier and faster. People review and approve.', href:'https://doclarity.eu/', link:'doclarity.eu'},
  {name:'Klartext Extract', theme:'extract', logo:'ventures/extract.svg', status:de ? 'Im Einsatz' : 'In market', title:de ? 'Unstrukturierte Dokumente. Verlässliche Daten.' : 'Unstructured documents. Reliable data.', copy:de ? 'Geschäftsberichte in Minuten auswerten. Jeder extrahierte KPI mit Verweis auf seine Quelle.' : 'Analyse annual reports in minutes. Every extracted KPI links back to its source.', href:`${root}success-stories/data-extraction-banking/`, link:de ? 'Zum Projekt' : 'Inside the project'},
  // Synea stays unnamed for now. The card keeps its colour and line art and names the sector and
  // the research partner; the logo, the name and the product itself are held back. To bring it
  // back once we can talk about it publicly: move docs/brand/synea.webp to public/ventures/,
  // swap this entry back in for the stealth one below, and put the name back into the ventures
  // meta description in StudioPage.astro.
  // {name:'Synea', theme:'venture3', logo:'ventures/synea.webp', status:'Stealth', title:de ? 'Lohnverrechnung. Konsequent automatisiert.' : 'Payroll. Accountable by design.', copy:de ? 'Wir arbeiten an deterministischer End-to-End-Automatisierung der Lohnverrechnung.' : 'Building deterministic end-to-end automation for payroll accounting.', href:'mailto:office@klartext-ai.com?subject=Synea', link:de ? 'Mit uns sprechen' : 'Talk to us'}
  {name:de ? 'Drittes Venture' : 'Third venture', theme:'venture3', stealth:true, status:'Stealth', title:de ? 'Finanzsektor. Mit Forschung im Rücken.' : 'Finance sector. Backed by research.', copy:de ? 'Unser drittes Venture entsteht gemeinsam mit einer der größten Wirtschaftsuniversitäten Europas. Mehr, sobald wir mehr sagen dürfen.' : 'Our third venture is taking shape with one of Europe’s largest business universities. More as soon as we can talk about it.', href:'mailto:office@klartext-ai.com?subject=Stealth%20Venture', link:de ? 'Mit uns sprechen' : 'Talk to us'}
];
---
<section class="studio-section venture-section" id="ventures">
  <div class="split-heading"><Heading>Built by<br /><span class="blue">Klartext AI.</span></Heading>{full && <p>{de ? 'Unsere Überzeugung. In Produkte übersetzt.' : 'Our ventures are our thesis, shipped.'}</p>}</div>
  <div class="venture-stack" style={`--venture-count:${ventures.length}`}>{ventures.map((v,i) => <article class={`venture-card ${v.theme}`} style={`--card-index:${i}`}>
    <div class="venture-art"><span class="kicker"><span class="kicker-scope">Built by Klartext AI ·</span> 0{i+1}</span>
      {v.logo ? <img class="venture-logo" src={`${base}${v.logo}`} alt={v.name} width="330" height="130" loading="lazy" /> : v.stealth ? <span class="venture-stealth" aria-hidden="true"><span class="stealth-mark" /><span class="stealth-word">{[34,22,41,18,29,45].map(w => <i style={`--w:${w}px`} />)}</span></span> : <span class="extract-wordmark">Klartext <strong>Extract</strong></span>}
      <svg class="venture-lines" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true">
        {v.theme === 'doclarity' && [0,1,2,3,4,5].map(n => <path d={`M-30 ${50+n*25} C100 ${-30+n*25} 200 ${180+n*18} 360 ${100+n*20} S520 ${30+n*22} 640 ${100+n*22}`} />)}
        {v.theme === 'extract' && [0,1,2,3,4].map(n => <path d={`M-20 ${35+n*30} H${130+n*25} V${15+n*24} H${345+n*25} V${75+n*24} H640`} />)}
        {v.theme === 'venture3' && [0,1,2,3,4,5].map(n => <path d={`M-40 ${70+n*27} L200 ${-15+n*27} L420 ${70+n*27} L650 ${-15+n*27}`} />)}
      </svg>
      <span class="venture-status">{v.status}</span>
    </div>
    <div class="venture-copy"><CardHeading>{v.title}</CardHeading><p>{v.copy}</p><a class="line-link" href={v.href}>{v.link} <span aria-hidden="true">↗</span></a></div>
  </article>)}</div>
  {full ? <div class="two-paths venture-origins"><div><p class="kicker"><span class="step-index">01</span> · {de ? 'Forschung' : 'Research'}</p><h2>{de ? 'Fragen, auf die es noch keine Antwort gibt.' : 'Questions with no off-the-shelf answer.'}</h2></div><div><p class="kicker"><span class="step-index">02</span> · Co-creation</p><h2>{de ? 'Mit Kunden entwickelt. Für viele weitergedacht.' : 'Built with customers. Made to go further.'}</h2></div></div> : <div class="section-end"><a class="line-link" href={`${root}ventures/`}>{de ? 'Unsere Ventures' : 'Explore our ventures'} <span aria-hidden="true">↗</span></a></div>}
</section>
