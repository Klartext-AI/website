---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const de = lang === 'de';

const title = 'Klartext AI - Links';
const description = de ? 'Alle Klartext AI Kanäle auf einen Blick.' : 'All Klartext AI channels at a glance.';

// Same number for WhatsApp and calls.
const PHONE_DISPLAY = '+43 660 81010 67';
const PHONE_E164 = '436608101067';
const whatsappHref = `https://wa.me/${PHONE_E164}?text=${encodeURIComponent(de ? 'Hallo Klartext AI!' : 'Hi Klartext AI!')}`;

type Link = { href: string; label: string; sub: string; icon: string };

const primaryLinks: Link[] = [
  { href: 'https://klartext-ai.com/', label: 'Website', sub: 'klartext-ai.com', icon: 'globe' },
  { href: 'https://www.linkedin.com/company/klartext-ai', label: 'LinkedIn', sub: '@klartext-ai', icon: 'linkedin' },
  { href: 'https://www.instagram.com/klartextai/', label: 'Instagram', sub: '@klartextai', icon: 'instagram' },
];

const moreLinks: Link[] = [
  { href: 'https://www.youtube.com/@KlartextAI', label: 'YouTube', sub: '@KlartextAI', icon: 'youtube' },
  { href: 'https://www.facebook.com/profile.php?id=61589510556370', label: 'Facebook', sub: 'Klartext AI', icon: 'facebook' },
  { href: 'https://open.spotify.com/user/31vz5zzehw3xn3dkxyfjukbzd6jy?si=4e306de0c3364bc4', label: 'Spotify', sub: 'Klartext AI', icon: 'spotify' },
  { href: 'https://x.com/Klartextai', label: 'X', sub: '@Klartextai', icon: 'x' },
  { href: 'https://www.tiktok.com/@klar.text.ai?lang=en-GB', label: 'TikTok', sub: '@klar.text.ai', icon: 'tiktok' },
  { href: 'https://www.reddit.com/user/Klartext_ai/', label: 'Reddit', sub: 'u/Klartext_ai', icon: 'reddit' },
];

const doclarityLinks: Link[] = [
  { href: 'https://doclarity.eu/', label: 'doclarity', sub: 'doclarity.eu', icon: 'doclarity' },
  { href: 'https://www.linkedin.com/company/doclarity/', label: de ? 'doclarity auf LinkedIn' : 'doclarity on LinkedIn', sub: '@doclarity', icon: 'linkedin' },
];

// Stroked (outline) icons; every other icon is a filled glyph.
const stroked = new Set(['globe', 'instagram']);
const paths: Record<string, string[]> = {
  globe: ['M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z', 'M2 12h20', 'M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'],
  linkedin: ['M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.4v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z'],
  instagram: ['M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z', 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z', 'M17.5 6.5h.01'],
  youtube: ['M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6z'],
  facebook: ['M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z'],
  spotify: ['M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm5.5 17.3a.75.75 0 0 1-1.03.25c-2.82-1.72-6.38-2.1-10.57-1.15a.75.75 0 1 1-.33-1.46c4.59-1.04 8.52-.6 11.68 1.33.36.22.47.69.25 1.03zm1.47-3.27a.94.94 0 0 1-1.29.3c-3.23-1.98-8.16-2.56-11.98-1.4a.94.94 0 1 1-.55-1.8c4.37-1.32 9.8-.68 13.52 1.6.45.27.59.86.3 1.3zm.13-3.4c-3.87-2.3-10.27-2.51-13.97-1.39a1.12 1.12 0 1 1-.66-2.15c4.25-1.29 11.31-1.04 15.78 1.61a1.12 1.12 0 1 1-1.15 1.93z'],
  x: ['M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'],
  tiktok: ['M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.66a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.09z'],
  reddit: ['M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm6.13 13.7c.02.16.04.31.04.47 0 2.4-2.79 4.36-6.23 4.36s-6.23-1.96-6.23-4.36c0-.16.02-.31.04-.47a1.52 1.52 0 1 1 1.7-2.45 7.65 7.65 0 0 1 4.16-1.32l.8-3.75a.34.34 0 0 1 .4-.26l2.62.56a1.05 1.05 0 1 1-.1.41l-2.34-.5-.72 3.37a7.6 7.6 0 0 1 4.1 1.31 1.52 1.52 0 1 1 1.76 2.63zM8.38 13.6a1.1 1.1 0 1 0 2.2 0 1.1 1.1 0 0 0-2.2 0zm6.07 2.84a.35.35 0 0 0-.5-.5 3.34 3.34 0 0 1-3.9 0 .35.35 0 0 0-.5.5 4.03 4.03 0 0 0 4.9 0zm-.92-1.74a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z'],
  whatsapp: ['M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88zM20.52 3.45A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41z'],
  phone: ['M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z'],
};
---

<BaseLayout title={title} description={description} lang={lang} alwaysShowNav={true}>
  <div class="linktree-page">
    <div class="linktree-container">
      <header class="linktree-header fade-in">
        <h1>{de ? 'Schön, dass Du da bist!' : 'Great to have you here!'}</h1>
        <p>{de ? 'Folge uns auf Deinem Lieblingskanal.' : 'Follow us on your favorite channel.'}</p>
      </header>

      <div class="actions fade-in" style="animation-delay: 0.1s">
        <div class="contact-row">
          <a href={whatsappHref} class="pill-button pill-button-whatsapp" target="_blank" rel="noopener noreferrer" aria-label={de ? 'WhatsApp-Nachricht schreiben' : 'Message us on WhatsApp'}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {paths.whatsapp.map((d) => <path d={d}></path>)}
            </svg>
            <span>WhatsApp</span>
          </a>
          <a href={`tel:+${PHONE_E164}`} class="pill-button" aria-label={`${de ? 'Anrufen' : 'Call'} ${PHONE_DISPLAY}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {paths.phone.map((d) => <path d={d}></path>)}
            </svg>
            <span class="number">{PHONE_DISPLAY}</span>
          </a>
        </div>
        <a href="https://showroom.klartext-ai.com/" class="pill-button pill-button-outline" target="_blank" rel="noopener noreferrer">
          Klartext Showroom <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <section class="links-section">
        <ul class="link-list fade-in" style="animation-delay: 0.18s">
          {primaryLinks.map((link) => (
            <li>
              <a href={link.href} class="link-pill" target="_blank" rel="noopener noreferrer">
                <span class="link-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill={stroked.has(link.icon) ? 'none' : 'currentColor'} stroke={stroked.has(link.icon) ? 'currentColor' : 'none'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    {paths[link.icon].map((d) => <path d={d}></path>)}
                  </svg>
                </span>
                <span class="link-text">
                  <span class="link-label">{link.label}</span>
                  <span class="link-sub">{link.sub}</span>
                </span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="more-channels fade-in" style="animation-delay: 0.26s">
          <button type="button" class="more-toggle" aria-expanded="false" aria-controls="more-channels-panel" data-more-toggle>
            {de ? 'Weitere Kanäle' : 'More channels'}
            <svg class="plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>

          <div class="more-panel" id="more-channels-panel" inert>
            <div class="more-panel-inner">
            <ul class="link-list more-list">
              {moreLinks.map((link) => (
                <li>
                  <a href={link.href} class="link-pill" target="_blank" rel="noopener noreferrer">
                    <span class="link-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        {paths[link.icon].map((d) => <path d={d}></path>)}
                      </svg>
                    </span>
                    <span class="link-text">
                      <span class="link-label">{link.label}</span>
                      <span class="link-sub">{link.sub}</span>
                    </span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
            </div>
          </div>
        </div>

        <ul class="link-list doclarity-list fade-in" style="animation-delay: 0.34s">
          {doclarityLinks.map((link) => (
            <li>
              <a href={link.href} class="link-pill" target="_blank" rel="noopener noreferrer">
                <span class="link-icon" aria-hidden="true">
                  {link.icon === 'doclarity' ? (
                    <svg class="doclarity-mark" viewBox="0 0 100 100">
                      <path d="M67.8 19.3 A35.5 35.5 0 1 0 67.8 80.7" fill="none" stroke="#131922" stroke-width="22" stroke-linecap="round"></path>
                      <circle cx="85.5" cy="50" r="13" fill="#1c4fd6"></circle>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      {paths[link.icon].map((d) => <path d={d}></path>)}
                    </svg>
                  )}
                </span>
                <span class="link-text">
                  <span class="link-label">{link.label}</span>
                  <span class="link-sub">{link.sub}</span>
                </span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  // The list used to be a <details> that snapped open by ~500px in one frame.
  // It now grows smoothly (grid-template-rows) and never touches the scroll position.
  document.querySelectorAll<HTMLButtonElement>('[data-more-toggle]').forEach((button) => {
    const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
      panel.toggleAttribute('inert', !open);
    });
  });
</script>

<style is:global>
  /* Keep room for a classic scrollbar so the page doesn't shift sideways when the list opens. */
  html { scrollbar-gutter: stable; }
</style>

<style>
  /* Follows the studio system in src/styles/studio.css: pill controls, hairline borders,
     the ↗ glyph, and a blue + for disclosure (as in the FAQ). */
  .linktree-page {
    min-height: calc(100vh - 60px);
    padding: 70px 0 var(--space-xl);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .linktree-container {
    width: 100%;
    max-width: 560px;
    padding: 0 22px;
  }

  .linktree-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .linktree-header h1 {
    font-size: clamp(40px, 9vw, 60px);
    font-weight: 350;
    line-height: 1.06;
    letter-spacing: -0.055em;
    color: var(--color-text-dark);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .linktree-header p {
    font-size: clamp(18px, 2.4vw, 21px);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    text-wrap: balance;
  }

  /* WhatsApp, call, showroom */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 45px;
  }

  .contact-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
  }

  .pill-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 64px;
    padding: 0 28px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-on-fill);
    background: var(--color-blue);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s;
  }

  .pill-button:hover {
    color: var(--color-on-fill);
    transform: translateY(-2px);
  }

  .pill-button-whatsapp {
    background: var(--color-whatsapp);
  }

  .pill-button svg {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .pill-button .number {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .pill-button-outline {
    color: var(--color-text-dark);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .pill-button-outline:hover {
    color: var(--color-text-dark);
  }

  .pill-button-outline .arrow {
    color: var(--color-blue);
  }

  /* Link pills */
  .links-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .doclarity-list {
    margin-top: 33px;
  }

  .link-pill {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 64px;
    padding: 8px 24px 8px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-text-dark);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .link-pill:hover {
    color: var(--color-text-dark);
  }

  .link-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-blue-soft);
    color: var(--color-blue);
  }

  .link-icon svg {
    width: 22px;
    height: 22px;
  }

  .doclarity-list .link-icon {
    background: var(--color-doclarity-soft);
    color: var(--color-doclarity);
  }

  /* Contrast schemes: the doclarity mark's ink would vanish on a dark page, so it is drawn
     in the text colour like the icons beside it. */
  :global(html[data-contrast]) .doclarity-mark path { stroke: currentColor; }
  :global(html[data-contrast]) .doclarity-mark circle { fill: currentColor; }

  .link-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .link-label {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
  }

  .link-sub {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    flex-shrink: 0;
    font-size: 22px;
    line-height: 1;
    color: var(--color-blue);
    transition: transform 0.2s;
  }

  .link-pill:hover .arrow,
  .pill-button:hover .arrow {
    transform: translate(3px, -3px);
  }

  /* More channels: a smaller, centred pill with no hover effect; the + turns into × like the FAQ */
  .more-channels {
    display: flex;
    flex-direction: column;
  }

  .more-toggle {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px 0 22px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-dark);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .plus {
    width: 18px;
    height: 18px;
    color: var(--color-blue);
  }

  .more-toggle[aria-expanded='true'] .plus {
    transform: rotate(45deg);
  }

  .more-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .more-panel.open {
    grid-template-rows: 1fr;
  }

  /* Collapses to exactly 0px: all spacing lives inside it. Side padding keeps focus rings unclipped. */
  .more-panel-inner {
    min-height: 0;
    overflow: hidden;
    margin: 0 -4px;
    padding: 0 4px;
  }

  .more-list {
    padding: 12px 0 4px;
  }

  .pill-button:focus-visible,
  .link-pill:focus-visible,
  .more-toggle:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fade-in {
    opacity: 0;
    animation: fadeIn 0.7s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @media (prefers-reduced-motion: no-preference) {
    .plus { transition: transform 0.3s ease-in-out; }
  }

  @media (prefers-reduced-motion: reduce) {
    .more-panel,
    .arrow,
    .pill-button {
      transition: none;
    }

    .fade-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
