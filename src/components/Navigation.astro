---
import { getLanguagePaths } from '../utils/i18n';
interface Props { lang?: 'de' | 'en'; alwaysVisible?: boolean }
const { lang = 'de' } = Astro.props;
const de = lang === 'de';
const base = import.meta.env.BASE_URL;
const root = `${base}${de ? 'de/' : ''}`;
const paths = getLanguagePaths(Astro.url.pathname, base);
// The nav labels stay English in both languages, like Research, Ventures and Ecosystem.
const links = [['The Studio','team'],['Research','research'],['Solutions', de ? 'leistungen' : 'services'],['Ventures','ventures'],['Ecosystem','ecosystem']];
---
<header class="studio-nav">
  <a class="studio-skip" href="#page-content">{de ? 'Zum Inhalt' : 'Skip to content'}</a>
  <div class="studio-nav-inner">
    <a class="studio-brand" href={root}>
      <img src={`${base}ventures/klartext.svg`} alt="Klartext AI" width="120" height="38" />
    </a>
    <nav class="studio-desktop-nav" aria-label={de ? 'Hauptnavigation' : 'Main navigation'}>
      {links.map(([label,slug]) => <a href={`${root}${slug}/`} aria-current={Astro.url.pathname.replace(/\/$/, '') === `${root}${slug}` ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="studio-nav-actions">
      <div class="studio-language" role="group" aria-label={de ? 'Sprache' : 'Language'}>
        <a data-language-choice="en" href={paths.en} hreflang="en" lang="en" aria-current={de ? undefined : 'true'} aria-label="English">EN</a>
        <a data-language-choice="de" href={paths.de} hreflang="de" lang="de" aria-current={de ? 'true' : undefined} aria-label="Deutsch">DE</a>
      </div>
      <a class="studio-nav-cta" href="mailto:office@klartext-ai.com">{de ? 'Kontakt' : 'Contact'} <span aria-hidden="true">↗</span></a>
      <button class="studio-menu-toggle" type="button" aria-expanded="false" aria-controls="studio-mobile-nav">{de ? 'Menü' : 'Menu'} <span class="menu-icon" aria-hidden="true"></span></button>
    </div>
  </div>
  <nav class="studio-mobile-nav" id="studio-mobile-nav" aria-label={de ? 'Mobile Navigation' : 'Mobile navigation'} hidden>
    <div class="studio-mobile-nav-inner">
      {links.map(([label,slug]) => <a href={`${root}${slug}/`}>{label} <span aria-hidden="true">↗</span></a>)}
      <a href="mailto:office@klartext-ai.com">{de ? 'Kontakt' : 'Contact'} <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<noscript><style>
  @media(max-width:1120px) {
    .studio-nav { position: relative !important; }
    .studio-menu-toggle { display: none !important; }
    .studio-mobile-nav[hidden] { display: grid !important; grid-template-rows: 1fr !important; opacity: 1 !important; }
    .studio-mobile-nav[hidden] .studio-mobile-nav-inner { padding-block: 8px 24px !important; }
  }
</style></noscript>
<style>
  .studio-nav { position: fixed; inset: 0 0 auto; z-index: 100; background: var(--color-paper); border-bottom: 1px solid var(--color-line); }
  /* A fixed blur on a narrow surface; scrolling supplies the changing texture. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .studio-nav {
      background: color-mix(in srgb, var(--color-paper) 72%, transparent);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      box-shadow: inset 0 -1px var(--glass-border), 0 8px 28px -24px var(--color-blue);
    }
  }
  .studio-nav-inner { max-width: 1440px; margin: auto; min-height: 64px; padding: 8px clamp(20px,4vw,65px); position: relative; display: flex; align-items: center; justify-content: space-between; gap: 25px; }
  .studio-brand { display: flex; flex-shrink: 0; }
  .studio-brand img { width: 108px; height: 36px; object-fit: contain; }
  .studio-desktop-nav,.studio-nav-actions { display: flex; align-items: center; gap: 26px; }
  .studio-nav a { color: var(--color-text-dark); font-size: 16px; }
  .studio-desktop-nav { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; }
  .studio-desktop-nav a { position: relative; padding-block: 12px; transition: color .3s cubic-bezier(.16,1,.3,1); }
  .studio-nav a:hover,.studio-nav a[aria-current] { color: var(--color-blue); }
  /* The rule wipes in from the left on hover and retreats to the right on leave. */
  .studio-desktop-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 6px; height: 1.5px; background: var(--color-blue); transform: scaleX(0); transform-origin: right; transition: transform .4s cubic-bezier(.16,1,.3,1); }
  .studio-desktop-nav a:hover::after,.studio-desktop-nav a:focus-visible::after { transform: scaleX(1); transform-origin: left; }
  /* The language toggle and the CTA share one height so they read as a pair. */
  .studio-nav-actions { --nav-control-h: 36px; gap: 10px; margin-left: auto; }
  .studio-language { display: flex; align-items: center; gap: 2px; padding: 3px; border: 1px solid var(--color-line); border-radius: 30px; }
  .studio-nav .studio-language a { display: grid; place-items: center; min-width: 36px; min-height: calc(var(--nav-control-h) - 8px); border-radius: 30px; font-size: 13px; font-weight: 500; color: var(--color-text-muted); }
  .studio-nav .studio-language a[aria-current] { background: var(--color-blue-soft); color: var(--color-blue); }
  .studio-nav .studio-nav-cta { padding: 0 14px; min-height: var(--nav-control-h); border-radius: 30px; background: var(--color-blue); color: var(--color-paper); display: flex; gap: 8px; align-items: center; font-size: 15px; }
  .studio-nav .studio-nav-cta:hover { color: var(--color-paper); }
  .studio-menu-toggle { display: none; }
  /* Two bars crossed into a plus; a 135° turn lands it on a close cross. */
  .menu-icon { position: relative; width: 15px; height: 15px; flex: none; transition: transform .34s cubic-bezier(.22,1,.36,1); }
  .menu-icon::before,.menu-icon::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 1.5px; border-radius: 2px; background: currentColor; }
  .menu-icon::after { rotate: 90deg; }
  .studio-menu-toggle[aria-expanded="true"] { color: var(--color-blue); }
  .studio-menu-toggle[aria-expanded="true"] .menu-icon { transform: rotate(135deg); }
  /* The panel unrolls via grid rows, so the nav's own height animates with it. */
  .studio-mobile-nav[hidden] { display: none; }
  .studio-mobile-nav { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .34s cubic-bezier(.22,1,.36,1), opacity .24s ease; }
  .studio-mobile-nav.is-open { grid-template-rows: 1fr; opacity: 1; }
  .studio-mobile-nav-inner { min-height: 0; max-height: calc(100svh - 64px); overflow-x: hidden; overflow-y: auto; padding: 0 24px; transition: padding-block .34s cubic-bezier(.22,1,.36,1); }
  .studio-mobile-nav.is-open .studio-mobile-nav-inner { padding-block: 8px 24px; }
  .studio-mobile-nav a { display: flex; justify-content: space-between; font-size: 22px; padding: 15px 0; border-bottom: 1px solid var(--color-line); }
  .studio-skip { position: absolute; top: -100px; left: 20px; padding: 12px; background: var(--color-paper); }
  .studio-skip:focus { top: 10px; z-index: 2; }
  @media(max-width:1120px) { .studio-desktop-nav { display: none; } .studio-menu-toggle { display: flex; gap: 12px; align-items: center; min-height: 44px; padding: 8px; border: 0; background: transparent; color: var(--color-text-dark); font: inherit; font-size: 16px; cursor: pointer; } }
  /* A compact bar on phones, so the opening keeps as much of the screen as possible. */
  @media(max-width:600px) {
    .studio-nav-inner { gap: 8px; min-height: 56px; padding-block: 6px; }
    .studio-brand img { width: 84px; height: auto; }
    .studio-nav-actions { --nav-control-h: 36px; gap: 4px; }
    .studio-nav .studio-language a { min-width: 34px; font-size: 13px; }
    .studio-menu-toggle { gap: 10px; font-size: 15px; }
    .studio-mobile-nav-inner { max-height: calc(100svh - 56px); }
  }
  @media(max-width:450px) { .studio-nav-cta { display: none !important; } }
  /* Translucent is fine over the page, but the open panel needs to stand on its own.
     The background is opaque here, so the blur behind it is invisible — and dropping it
     matters: the panel unrolls by animating grid rows, so every frame of that relayout
     would otherwise re-capture and re-blur a backdrop of changing size. */
  .studio-nav:has(.studio-mobile-nav:not([hidden])) { background: var(--color-paper); box-shadow: 0 22px 40px -30px rgba(36,121,190,.55); -webkit-backdrop-filter: none; backdrop-filter: none; }
  @media (prefers-reduced-transparency: reduce) { .studio-nav { background: var(--color-paper); -webkit-backdrop-filter: none; backdrop-filter: none; } }
  @media(prefers-reduced-motion:reduce) { .menu-icon,.studio-mobile-nav,.studio-mobile-nav-inner,.studio-desktop-nav a,.studio-desktop-nav a::after { transition: none; } }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.studio-menu-toggle');
  const menu = document.querySelector<HTMLElement>('.studio-mobile-nav');
  const OPEN_DURATION = 340;
  let hideTimer: number | undefined;

  // `hidden` can't transition, so it is dropped before opening and only restored
  // once the closing animation has run.
  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    clearTimeout(hideTimer);
    toggle.setAttribute('aria-expanded', String(open));
    const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (open) {
      menu.hidden = false;
      if (instant) menu.classList.add('is-open');
      else requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
      return;
    }
    menu.classList.remove('is-open');
    if (instant) { menu.hidden = true; return; }
    hideTimer = window.setTimeout(() => {
      if (toggle.getAttribute('aria-expanded') !== 'true') menu.hidden = true;
    }, OPEN_DURATION);
  }

  function closeMenu(restoreFocus = false) {
    if (!toggle || !menu || toggle.getAttribute('aria-expanded') !== 'true') return;
    setMenu(false);
    if (restoreFocus) toggle.focus();
  }
  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true);
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !document.querySelector('.studio-nav')?.contains(event.target)) closeMenu();
  });
  matchMedia('(min-width:1121px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
  document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]').forEach(link => {
    link.addEventListener('click', () => { try { localStorage.setItem('kt-lang-choice', link.dataset.languageChoice!); } catch {} });
  });
</script>
