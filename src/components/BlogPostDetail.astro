---
interface Props {
  title: string;
  excerpt: string;
  fullExcerpt: string;
  fullContent: string;
  category: string;
  readTime: string;
  date: string;
  lang?: 'de' | 'en';
}

const { title, excerpt, fullExcerpt, fullContent, category, readTime, date, lang = 'de' } = Astro.props;

const labels = {
  de: {
    backToBlog: "← Zurück zum Blog",
    category: "Kategorie",
    readTime: "Lesezeit",
    published: "Veröffentlicht"
  },
  en: {
    backToBlog: "← Back to Blog",
    category: "Category",
    readTime: "Read time",
    published: "Published"
  }
};

const text = labels[lang];
const BASE = import.meta.env.BASE_URL;
const SITE = Astro.site?.toString() ?? 'https://klartext-ai.github.io';
const canonicalHref = Astro.url?.href ?? new URL(BASE, SITE).toString();
---

<section class="blog-post-detail section">
  <div class="container">
    <article class="post-content fade-in">
      <a href={lang === 'en' ? `${BASE}blog` : `${BASE}de/blog`} class="back-link">
        {text.backToBlog}
      </a>

      <header class="post-header">
        <div class="post-meta-header">
          <span class="post-category-badge">{category}</span>
          <span class="post-meta-item">{readTime}</span>
          <span class="post-meta-item">{date}</span>
        </div>
        <h1 class="post-main-title">{title}</h1>
        <p class="post-excerpt-large">{excerpt}</p>
      </header>

      <div class="post-body">
        <div class="post-intro">
        <p class="lead-text" set:html={fullExcerpt}></p>
        </div>

        <div class="post-main-content" set:html={fullContent} />
      </div>
    </article>
  </div>
</section>

<!-- Structured Data: BlogPosting for GEO/SEO -->
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': excerpt,
  'articleSection': category,
  'inLanguage': lang,
  'datePublished': date,
  'dateModified': date,
  'mainEntityOfPage': canonicalHref,
  'author': {
    '@type': 'Organization',
    'name': 'Klartext AI',
    'url': SITE
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Klartext AI',
    'logo': {
      '@type': 'ImageObject',
      'url': new URL(`${BASE}LOGO_transparent.png`, SITE).toString()
    }
  }
})}></script>

<style>
  .blog-post-detail {
    min-height: 80vh;
    padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 6vw, 90px);
    background: transparent;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: 15px;
    margin-bottom: clamp(20px, 3vw, 40px);
    transition: color .2s ease-out;
  }

  .back-link:hover {
    color: var(--color-blue);
  }

  .post-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: clamp(32px, 3.5vw, 48px);
    padding-bottom: clamp(32px, 3.5vw, 48px);
    border-bottom: 1px solid var(--color-line);
  }

  .post-meta-header {
    display: flex;
    gap: 8px 22px;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: 22px;
    font-size: 14px;
  }

  .post-category-badge {
    font-size: 13px;
    font-weight: 550;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .post-meta-item {
    color: var(--color-text-muted);
  }

  .post-main-title {
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 350;
    line-height: 1.06;
    letter-spacing: -.055em;
    text-wrap: balance;
    margin-bottom: 24px;
    color: var(--color-text-dark);
  }

  .post-excerpt-large {
    font-size: clamp(18px, 1.45vw, 22px);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .post-intro {
    padding: 0;
  }

  .lead-text {
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.5;
    letter-spacing: -.015em;
    color: var(--color-text-dark);
    margin: 0;
  }

  .post-main-content {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-text-body);
  }

  .post-main-content :global(h2),
  .post-main-content :global(h3),
  .post-main-content :global(h4) {
    color: var(--color-text-dark);
    margin-top: clamp(40px, 4vw, 56px);
    margin-bottom: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .post-main-content :global(h2) {
    font-size: clamp(28px, 2.5vw, 36px);
  }

  .post-main-content :global(h3) {
    font-size: clamp(25px, 2.2vw, 31px);
  }

  .post-main-content :global(h4) {
    font-size: clamp(23px, 1.9vw, 27px);
  }

  .post-main-content :global(p) {
    margin-bottom: 18px;
  }

  .post-main-content :global(strong) {
    color: var(--color-text-dark);
    font-weight: 550;
  }

  .post-main-content :global(ul),
  .post-main-content :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-md);
  }

  .post-main-content :global(li) {
    margin-bottom: var(--space-sm);
  }

  .post-main-content :global(blockquote) {
    border-left: 2px solid var(--color-blue);
    padding-left: 24px;
    margin: 36px 0;
    font-size: clamp(20px, 1.6vw, 24px);
    line-height: 1.45;
    letter-spacing: -.02em;
    color: var(--color-text-dark);
  }

  .post-main-content :global(blockquote.quote-with-avatar) {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    border-left: 0;
    padding-left: 0;
  }

  .post-main-content :global(blockquote.quote-with-avatar .quote-avatar) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
  }

  .post-main-content :global(blockquote.quote-with-avatar .quote-text) {
    color: var(--color-text-dark);
  }

  .post-main-content :global(blockquote.quote-with-avatar .quote-text p) {
    margin: 0;
  }

  .post-main-content :global(code) {
    background: rgba(36, 121, 190, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  @media (max-width: 768px) {
    .post-main-content {
      font-size: 17px;
    }

    .post-main-content :global(blockquote.quote-with-avatar) {
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
    }

    .post-main-content :global(blockquote.quote-with-avatar .quote-text) {
      padding-left: 0;
      text-align: center;
    }

    .post-main-content :global(blockquote.quote-with-avatar .quote-avatar) {
      width: 56px;
      height: 56px;
    }
  }
</style>
