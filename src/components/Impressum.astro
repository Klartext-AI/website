---
interface Props {
  lang?: 'de' | 'en';
}

// One entry in a row: plain text, or a link. Arrays render as separate lines inside one entry.
type Entry = { text: string | string[]; href?: string; external?: boolean };
type Row = { label: string; entries: Entry[] };
type Group = { heading: string; rows: Row[] };

const { lang = 'de' } = Astro.props;

const MAP_URL = 'https://maps.app.goo.gl/QGynv1LF7EQwVgry7';
const WKO_URL = 'https://firmen.wko.at/klartext-ai-flexco/wien/?firmaid=e53c4fce-7663-480b-859b-e0c3caddd822&suchbegriff=klartext%20ai';
const PHONE = '+43 660 81010 67';
const EMAIL = 'office@klartext-ai.com';

const phone: Entry = { text: PHONE, href: `tel:${PHONE.replace(/\s/g, '')}` };
const email: Entry = { text: EMAIL, href: `mailto:${EMAIL}` };
const photographers: Entry[] = [
  { text: 'Leandra Schurz', href: 'https://www.leandraschurz.com/', external: true },
  { text: 'Zsolt Csutak', href: 'https://www.instagram.com/zsolt.csutak/', external: true }
];
const t = (...texts: string[]): Entry[] => texts.map((text) => ({ text }));

const content: Record<'de' | 'en', { title: string; groups: Group[] }> = {
  de: {
    title: 'Impressum',
    groups: [
      {
        heading: 'Unternehmen',
        rows: [
          { label: 'Unternehmensname', entries: t('Klartext AI FlexCo') },
          { label: 'Rechtsform', entries: t('FlexCo (FlexKapG)') },
          {
            label: 'Unternehmensgegenstand',
            entries: t(
              'Dienstleistungen in der automatischen Datenverarbeitung und Informationstechnik.',
              'Entwicklung und Betrieb von KI-gestützten Softwarelösungen mit Fokus auf Barrierefreiheit und verständliche Aufbereitung komplexer Informationen (z.B. Finanz- und Rechtsdokumente).'
            )
          },
          {
            label: 'Geschäftsführung',
            entries: t(
              'Ruben Helmut Hetfleisch, Geschäftsführer und gewerberechtlicher Geschäftsführer',
              'Daniel Toth, Geschäftsführer'
            )
          },
          { label: 'Gesellschafter', entries: t('Ruben Helmut Hetfleisch', 'Daniel Toth', 'Felix Krause') },
          { label: 'Stammkapital', entries: t('Das eingetragene Stammkapital ergibt sich aus dem Firmenbuch der Klartext AI FlexCo.') }
        ]
      },
      {
        heading: 'Kontakt',
        rows: [
          {
            label: 'Geschäftsadresse',
            entries: [{ text: ['Lerchenfelder Straße 74/2/7', '1080 Wien', 'Österreich'], href: MAP_URL, external: true }]
          },
          { label: 'Telefonnummer', entries: [phone] },
          { label: 'E-Mail-Adresse', entries: [email] }
        ]
      },
      {
        heading: 'Register und Aufsicht',
        rows: [
          { label: 'Firmenbuchnummer', entries: t('FN 643915 i') },
          { label: 'Firmenbuchgericht', entries: t('Handelsgericht Wien') },
          { label: 'UID-Nummer', entries: t('ATU81693669') },
          { label: 'GISA-Zahl', entries: t('38048296') },
          { label: 'GLN (Global Location Number)', entries: t('9110037185289') },
          { label: 'Zuständige Aufsichtsbehörde gem. ECG', entries: t('Magistratisches Bezirksamt des VIII. Bezirkes, 1080 Wien') },
          {
            label: 'Mitgliedschaft bei der Wirtschaftskammer',
            entries: [
              { text: 'Mitglied der Wirtschaftskammer Wien, Fachgruppe Unternehmensberatung, Buchhaltung und Informationstechnologie' },
              { text: 'WKO-Unternehmensprofil', href: WKO_URL, external: true }
            ]
          },
          {
            label: 'Anwendbare berufsrechtliche Vorschriften',
            entries: t('E-Commerce-Gesetz (ECG), Unternehmensgesetzbuch (UGB), Gewerbeordnung (GewO) in der jeweils geltenden Fassung.')
          }
        ]
      },
      {
        heading: 'Website',
        rows: [{ label: 'Fotos', entries: photographers }]
      }
    ]
  },
  en: {
    title: 'Imprint',
    groups: [
      {
        heading: 'Company',
        rows: [
          { label: 'Company name', entries: t('Klartext AI FlexCo') },
          { label: 'Legal form', entries: t('FlexCo (Austrian flexible corporation, FlexKapG)') },
          {
            label: 'Business purpose',
            entries: t(
              'Services in automatic data processing and information technology.',
              'Development and operation of AI-powered software solutions with a focus on accessibility and clear communication of complex information (e.g. financial and legal documents).'
            )
          },
          {
            label: 'Managing directors',
            entries: t(
              'Ruben Helmut Hetfleisch, managing director and trade representative under trade law',
              'Daniel Toth, managing director'
            )
          },
          { label: 'Shareholders', entries: t('Ruben Helmut Hetfleisch', 'Daniel Toth', 'Felix Krause') },
          { label: 'Share capital', entries: t('The registered share capital is as recorded in the commercial register for Klartext AI FlexCo.') }
        ]
      },
      {
        heading: 'Contact',
        rows: [
          {
            label: 'Business address',
            entries: [{ text: ['Lerchenfelder Straße 74/2/7', '1080 Vienna', 'Austria'], href: MAP_URL, external: true }]
          },
          { label: 'Phone number', entries: [phone] },
          { label: 'Email address', entries: [email] }
        ]
      },
      {
        heading: 'Registration and supervision',
        rows: [
          { label: 'Commercial register number', entries: t('FN 643915 i') },
          { label: 'Commercial register court', entries: t('Commercial Court of Vienna (Handelsgericht Wien)') },
          { label: 'VAT ID', entries: t('ATU81693669') },
          { label: 'GISA number', entries: t('38048296') },
          { label: 'GLN (Global Location Number)', entries: t('9110037185289') },
          { label: 'Supervisory authority pursuant to the E-Commerce Act', entries: t('Magistrate District Office of the 8th District, 1080 Vienna') },
          {
            label: 'Chamber membership',
            entries: [
              { text: 'Member of the Vienna Economic Chamber, Professional Association for Management Consultancy, Accounting and Information Technology' },
              { text: 'WKO company profile', href: WKO_URL, external: true }
            ]
          },
          {
            label: 'Applicable professional regulations',
            entries: t('E-Commerce Act (ECG), Austrian Commercial Code (UGB), Trade Regulation Act (GewO), each as amended.')
          }
        ]
      },
      {
        heading: 'Website',
        rows: [{ label: 'Photography', entries: photographers }]
      }
    ]
  }
};

const text = content[lang];
const lines = (value: string | string[]) => (Array.isArray(value) ? value : [value]);
---

<section id="impressum" class="impressum section">
  <div class="container">
    <div class="impressum-content fade-in">
      <h1 class="impressum-title">{text.title}</h1>

      {text.groups.map((group) => (
        <section class="impressum-group" aria-labelledby={`impressum-${group.heading.toLowerCase().replace(/\W+/g, '-')}`}>
          <h2 id={`impressum-${group.heading.toLowerCase().replace(/\W+/g, '-')}`}>{group.heading}</h2>
          <dl>
            {group.rows.map((row) => (
              <div class="impressum-row">
                <dt>{row.label}</dt>
                {row.entries.map((entry) => (
                  <dd>
                    {entry.href ? (
                      <a
                        href={entry.href}
                        {...(entry.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {lines(entry.text).map((line, i) => (
                          <Fragment>{i > 0 && <br />}{line}</Fragment>
                        ))}
                      </a>
                    ) : (
                      lines(entry.text).map((line, i) => (
                        <Fragment>{i > 0 && <br />}{line}</Fragment>
                      ))
                    )}
                  </dd>
                ))}
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .impressum {
    min-height: 80vh;
    padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 6vw, 90px);
    background: transparent;
  }

  .impressum-content {
    max-width: 880px;
    margin: 0 auto;
  }

  .impressum-title {
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 350;
    line-height: 1.06;
    letter-spacing: -.055em;
    color: var(--color-text-dark);
    margin: 0 0 clamp(32px, 3.5vw, 48px);
    padding-bottom: clamp(32px, 3.5vw, 48px);
    border-bottom: 1px solid var(--color-line);
  }

  .impressum-group + .impressum-group {
    margin-top: clamp(44px, 5vw, 72px);
  }

  .impressum-group h2 {
    font-size: clamp(25px, 2.2vw, 31px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.035em;
    color: var(--color-text-dark);
    margin: 0 0 14px;
  }

  .impressum-group dl {
    margin: 0;
  }

  .impressum-row {
    display: grid;
    grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.64fr);
    column-gap: clamp(20px, 3vw, 40px);
    padding: 18px 0;
    border-top: 1px solid var(--color-line);
  }

  .impressum-row dt {
    grid-column: 1;
    grid-row: 1 / span 10;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
    padding-top: 2px;
  }

  .impressum-row dd {
    grid-column: 2;
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-dark);
  }

  .impressum-row dd + dd {
    margin-top: 8px;
  }

  .impressum-row a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color .2s ease-out, text-decoration-color .2s ease-out;
  }

  .impressum-row a:hover {
    color: var(--color-blue);
    text-decoration-color: currentColor;
  }

  @media (max-width: 640px) {
    .impressum-row {
      grid-template-columns: minmax(0, 1fr);
      padding: 16px 0;
    }

    .impressum-row dt {
      grid-row: auto;
      padding-top: 0;
      margin-bottom: 4px;
    }

    .impressum-row dd {
      grid-column: 1;
      font-size: 17px;
    }
  }
</style>
