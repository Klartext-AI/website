---
// The contrast switch for the navigation: one icon button opening the list of schemes. Same
// schemes and effect as the footer's ContrastPalette, in the single slot the nav can spare.
//
// Menu semantics (APG menu button): picking a scheme acts at once rather than staging a value.
// Each row is a menuitemradio, so assistive tech announces the choice and which one is on.
// Keyboard: Enter, Space or the arrow keys open on the active scheme, arrows and Home/End move,
// Escape closes back to the button, Tab closes and moves on.
import { CONTRAST_COPY, CONTRAST_SCHEMES, formatRatio, schemeName, schemeRatio } from '../utils/contrast-schemes';
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const copy = CONTRAST_COPY[lang];
// The current scheme completes the button's name, so its value is known without opening it.
const current = Object.fromEntries(CONTRAST_SCHEMES.map((scheme) => [scheme.id, `${copy.adjust}: ${scheme.label[lang]}`]));
---
<div class="contrast-menu">
  <button
    type="button"
    class="contrast-trigger"
    id="contrast-trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="contrast-options"
    aria-label={copy.adjust}
    data-label-default={copy.adjust}
    data-label-current={JSON.stringify(current)}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.75" />
      <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
    </svg>
  </button>
  <div class="contrast-options" id="contrast-options" role="menu" aria-labelledby="contrast-trigger" hidden style={`--contrast-rows: ${Math.ceil(CONTRAST_SCHEMES.length / 2)}`}>
    {CONTRAST_SCHEMES.map((scheme) => {
      const ratio = schemeRatio(scheme);
      return (
        <button type="button" role="menuitemradio" tabindex="-1" aria-checked={scheme.id === 'default' ? 'true' : 'false'} aria-label={schemeName(scheme, lang)} data-contrast-choice={scheme.id}>
          <span class="contrast-specimen" aria-hidden="true" style={`--swatch-fg: ${scheme.fg}; --swatch-bg: ${scheme.bg}`}><span>a</span></span>
          <span class="contrast-name" aria-hidden="true">{scheme.label[lang]}</span>
          {ratio !== null && <span class="contrast-ratio" aria-hidden="true">{formatRatio(ratio, lang)}:1</span>}
          <svg class="contrast-check" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      );
    })}
  </div>
</div>

<style>
  .contrast-menu { position: relative; display: flex; }
  /* Same height and outline as the language switch beside it, so the two read as a pair. */
  .contrast-trigger { position: relative; display: grid; place-items: center; width: var(--nav-control-h, 36px); height: var(--nav-control-h, 36px); padding: 0; border: 1px solid var(--color-line); border-radius: 50%; background: transparent; color: var(--color-text-dark); cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transition: color .2s ease, border-color .2s ease; }
  /* The circle stays the bar's 36px, but the hit area reaches 44px for touch. */
  .contrast-trigger::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; }
  .contrast-trigger:hover, .contrast-trigger[aria-expanded="true"] { color: var(--color-blue); border-color: currentColor; }
  /* Desktop: a panel centred under the icon, as wide as its longest row, so no name wraps. Its
     top is set on open to just below the bar's bottom edge (see the script). */
  .contrast-options { position: absolute; top: calc(100% + 26px); left: 50%; z-index: 10; width: max-content; min-width: 340px; max-width: calc(100vw - 16px); padding: 8px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-paper); box-shadow: var(--shadow-lg); transform: translateX(-50%); }
  /* Opens and closes with opacity and translate only, so the compositor runs it without layout.
     `allow-discrete` keeps the panel displayed until its fade-out has finished, and
     @starting-style gives the fade-in its first frame. Browsers without either just snap. */
  .contrast-options { transition: opacity .2s ease, translate .28s cubic-bezier(.22,1,.36,1), display .28s allow-discrete; }
  .contrast-options[hidden] { display: none; opacity: 0; translate: 0 -6px; pointer-events: none; }
  @starting-style { .contrast-options:not([hidden]) { opacity: 0; translate: 0 -6px; } }
  /* Rows are generous on purpose: the people reaching for this menu are the ones who struggle
     with small, tightly packed targets. */
  .contrast-options button { display: flex; align-items: center; gap: 14px; width: 100%; min-height: 56px; padding: 8px 12px; border: 0; border-radius: 10px; background: transparent; color: var(--color-text-dark); font: inherit; font-size: 18px; text-align: left; white-space: nowrap; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  /* Hover only where there is a pointer to hover with; on touch it would stick after the tap. */
  @media (hover: hover) { .contrast-options button:hover { background: var(--color-blue-tint-strong); } }
  .contrast-options button:focus-visible { outline-offset: -2px; }
  .contrast-specimen { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border: 2px solid var(--swatch-fg); border-radius: 8px; background: var(--swatch-bg); color: var(--swatch-fg); font-size: 17px; font-weight: 600; line-height: 1; }
  /* Centre the glyph, not its line box (see ContrastPalette.astro). The trim sits on the inner
     span: text-box does not reach the anonymous item inside a grid container. */
  .contrast-specimen span { text-box: trim-both ex alphabetic; }
  @supports not (text-box: trim-both ex alphabetic) { .contrast-specimen span { padding-bottom: .18em; } }
  .contrast-name { flex: 1; min-width: 0; padding-right: 12px; }
  .contrast-ratio { color: var(--color-text-muted); font-size: 14px; font-variant-numeric: tabular-nums; }
  .contrast-check { flex: none; visibility: hidden; color: var(--color-blue); }
  [aria-checked="true"] .contrast-check { visibility: visible; }
  /* Phones and tablets: the panel behaves like the Menu beside it, a full-width sheet under
     the bar with large rows and hairlines between them. Releasing the wrapper's positioning
     hands the panel to the nav's inner row, which spans the screen. */
  @media (max-width: 1120px) {
    .contrast-menu { position: static; }
    /* Starts under the bar's 1px bottom border rather than over it, so the line stays put
       while the sheet fades in and out instead of showing through and then vanishing. The bar
       itself does not change; the sheet is its own surface. */
    .contrast-options { top: calc(100% + 1px); left: 0; right: 0; width: auto; min-width: 0; max-width: none; max-height: calc(100svh - 64px); overflow-y: auto; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: repeat(var(--contrast-rows), auto); grid-auto-flow: column; column-gap: 32px; padding: 4px 24px 24px; border: 0; border-bottom: 1px solid var(--color-line); border-radius: 0; box-shadow: 0 22px 40px -30px color-mix(in srgb, var(--shadow-color) 55%, transparent); transform: none; }
    .contrast-options button { min-height: 60px; padding: 10px 0; border-bottom: 1px solid var(--color-line); border-radius: 0; font-size: 19px; }
    /* Feedback by underline rather than by turning the name blue: the brand blue is just under
       AA at this size (AGENTS.md). */
    @media (hover: hover) { .contrast-options button:hover { background: transparent; } .contrast-options button:hover .contrast-name { text-decoration: underline; text-underline-offset: 4px; } }
    .contrast-options button:active .contrast-name { text-decoration: underline; text-underline-offset: 4px; }
    /* The sheet travels a little further, in step with the Menu unrolling beside it. */
    .contrast-options { transition-duration: .24s, .34s, .34s; }
    .contrast-options[hidden] { translate: 0 -12px; }
    @starting-style { .contrast-options:not([hidden]) { translate: 0 -12px; } }
    .contrast-specimen { width: 38px; height: 38px; font-size: 17px; }
  }
  /* Tablets get two columns filled top to bottom, so the arrow keys follow the reading order;
     phones get one. */
  @media (max-width: 600px) { .contrast-options { max-height: calc(100svh - 56px); padding-inline: 20px; grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; } }
  @media (prefers-reduced-motion: reduce) { .contrast-trigger, .contrast-options { transition: none; } }
</style>

<script>
  import { onSchemeChange, setScheme } from '../scripts/contrast';
  import type { ContrastScheme } from '../utils/contrast-schemes';

  /** Breathing room the panel keeps from the viewport edges, and from the bar above it. */
  const VIEWPORT_MARGIN = 8;
  const BAR_GAP = 10;
  /** Below this width the panel is a full-width sheet (see the styles), matching the Menu. */
  const sheet = matchMedia('(max-width: 1120px)');

  document.querySelectorAll<HTMLElement>('.contrast-menu').forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLButtonElement>('.contrast-trigger')!;
    const menu = wrap.querySelector<HTMLElement>('.contrast-options')!;
    const items = Array.from(menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]'));
    const labels = JSON.parse(trigger.dataset.labelCurrent ?? '{}') as Record<ContrastScheme, string>;

    const isOpen = () => !menu.hidden;
    const close = (returnFocus: boolean) => {
      if (!isOpen()) return;
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus({ preventScroll: true });
    };
    const open = () => {
      // One sheet under the bar at a time: opening this one folds the Menu away.
      document.querySelector<HTMLButtonElement>('.studio-menu-toggle[aria-expanded="true"]')?.click();
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      // On desktop the panel is centred under the icon; should that push it past a viewport
      // edge, it is nudged back inside. The full-width sheet below 1121px needs none of this.
      // The nudge uses margin, which leaves `translate` to the open animation.
      menu.style.marginLeft = '';
      menu.style.top = '';
      if (!sheet.matches) {
        // Hang the panel from the bar's bottom edge, not from the icon: the icon sits mid-bar, so
        // any fixed offset from it overlaps the bar as soon as the bar's height changes. Rects
        // come back scaled by the laptop page zoom, offsetHeight does not, so their ratio
        // converts back to CSS pixels.
        const bar = wrap.closest('.studio-nav')!.getBoundingClientRect();
        const own = wrap.getBoundingClientRect();
        const scale = own.height / wrap.offsetHeight || 1;
        menu.style.top = `${Math.round((bar.bottom - own.top) / scale) + BAR_GAP}px`;
        const box = menu.getBoundingClientRect();
        const pastLeft = VIEWPORT_MARGIN - box.left;
        const pastRight = box.right - (innerWidth - VIEWPORT_MARGIN);
        if (pastLeft > 0) menu.style.marginLeft = `${Math.round(pastLeft / scale)}px`;
        else if (pastRight > 0) menu.style.marginLeft = `${-Math.round(pastRight / scale)}px`;
      }
      (items.find((item) => item.getAttribute('aria-checked') === 'true') ?? items[0]).focus({ preventScroll: true });
    };

    trigger.addEventListener('click', () => (isOpen() ? close(false) : open()));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); open(); }
    });
    items.forEach((item) => item.addEventListener('click', () => {
      setScheme(item.dataset.contrastChoice as ContrastScheme);
      close(true);
    }));
    menu.addEventListener('keydown', (event) => {
      const index = items.indexOf(document.activeElement as HTMLButtonElement);
      const focus = (i: number) => { event.preventDefault(); items[(i + items.length) % items.length].focus(); };
      if (event.key === 'ArrowDown') focus(index + 1);
      else if (event.key === 'ArrowUp') focus(index - 1);
      else if (event.key === 'Home') focus(0);
      else if (event.key === 'End') focus(items.length - 1);
      else if (event.key === 'Escape') { event.preventDefault(); close(true); }
      else if (event.key === 'Tab') close(false);
    });
    // Each layout places the panel differently, so crossing the breakpoint while it is open
    // (rotating a tablet) closes it, as the Menu does, rather than keeping the other layout's
    // inline placement.
    sheet.addEventListener('change', () => close(false));
    // `pointerdown`, so the panel is gone before the click lands on whatever lay under it.
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !wrap.contains(event.target)) close(false);
    });

    onSchemeChange((scheme) => {
      items.forEach((item) => item.setAttribute('aria-checked', String(item.dataset.contrastChoice === scheme)));
      trigger.setAttribute('aria-label', scheme === 'default' ? trigger.dataset.labelDefault ?? '' : labels[scheme]);
    });
  });
</script>
